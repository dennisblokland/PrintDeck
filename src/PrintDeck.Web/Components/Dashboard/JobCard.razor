@inherits PrinterComponent

<section class="card job-card">
	<header class="card-head">
		<h2>@(_job?.Kind == JobKind.SdUpload ? "Copying to SD card" : "Current print")</h2>
		@if (_job is { } j)
		{
			<span class="chip chip-@j.Status.ToString().ToLowerInvariant()">@j.Status</span>
		}
	</header>

	@if (_job is null)
	{
		<div class="empty">
			<Icon Name="file" Size="28" />
			<p>No print yet</p>
			<a class="btn btn-ghost" href="files"><Icon Name="folder" Size="16" /> Pick a file</a>
		</div>
	}
	else
	{
		JobDto job = _job;
		int done = (int)Math.Floor(job.Progress * _layers);
		string stackState = job.Status switch { JobStatus.Paused => "is-paused", JobStatus.Completed => "is-done", _ => "" };
		<div class="job-body">
			<div class="stack @stackState" aria-hidden="true">
				<div class="stack-layers">
					@for (int i = 0; i < _layers; i++)
					{
						<i class="stack-layer @(i < done ? "is-done" : i == done && job.Status is JobStatus.Printing or JobStatus.Paused ? "is-current" : "")"></i>
					}
				</div>
				<div class="stack-bed"></div>
				@if (job.Status is JobStatus.Printing or JobStatus.Paused)
				{
					<span class="stack-nozzle" style="transform:translateY(-@(Math.Min(done, _layers - 1) * 5)px)"></span>
				}
			</div>

			<div class="job-info">
				<p class="job-file" title="@job.FileName">
					@if (job.Kind == JobKind.SdPrint) { <Icon Name="sdcard" Size="14" /> }
					@job.FileName
				</p>
				<span class="job-percent">@((job.Progress * 100).ToString("0.0"))<small>%</small></span>
				<div class="bar" role="progressbar" aria-valuenow="@((int)(job.Progress * 100))" aria-valuemin="0" aria-valuemax="100">
					<div class="bar-fill @(job.Status == JobStatus.Paused ? "is-paused" : "")" style="transform:scaleX(@(job.Progress.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)))"></div>
				</div>
			</div>
		</div>

		<dl class="stats">
			<div><dt>Elapsed</dt><dd>@Format.Duration(job.Elapsed)</dd></div>
			<div><dt>Remaining</dt><dd>@(job.Status is JobStatus.Printing or JobStatus.Paused ? Format.Duration(job.Remaining) : "—")</dd></div>
			<div><dt>Finishes</dt><dd>@Eta(job)</dd></div>
			<div><dt>Lines</dt><dd>@(job.Kind == JobKind.SdPrint ? "On SD" : job.LinesSent.ToString("N0"))</dd></div>
		</dl>

		@if (CanControl && job.Status is JobStatus.Printing or JobStatus.Paused)
		{
			<div class="actions">
				@* An upload to the SD card can only be cancelled. *@
				@if (job.Kind != JobKind.SdUpload && job.Status == JobStatus.Printing)
				{
					<button class="btn" @onclick="() => Run(new PauseJobCommand())"><Icon Name="pause" Size="16" /> Pause</button>
				}
				else if (job.Kind != JobKind.SdUpload)
				{
					<button class="btn btn-primary" @onclick="() => Run(new ResumeJobCommand())"><Icon Name="play" Size="16" /> Resume</button>
				}
				<button class="btn btn-danger @(_confirmCancel ? "is-armed" : "")" @onclick="CancelAsync">
					<Icon Name="stop" Size="16" /> @(_confirmCancel ? "Confirm cancel" : "Cancel")
				</button>
			</div>
		}
	}
</section>

@code {
	private const int _layers = 24;
	private JobDto? _job;
	private bool _confirmCancel;
	private Timer? _ticker;

	protected override PrinterChange Interests => PrinterChange.Job | PrinterChange.State;
	protected override TimeSpan Throttle => TimeSpan.FromMilliseconds(500);

	protected override void OnInitialized() =>
		_ticker = new Timer(_ => { if (_job?.Status == JobStatus.Printing) _ = ReloadAsync(); }, null, 1000, 1000);

	protected override async Task RefreshAsync() => _job = (await Mediator.Send(new GetPrinterStatusQuery())).Job;

	private async Task CancelAsync()
	{
		if (!_confirmCancel)
		{
			_confirmCancel = true;
			_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { _confirmCancel = false; StateHasChanged(); }));
			return;
		}
		_confirmCancel = false;
		await Run(new CancelJobCommand(), _job?.Kind == JobKind.SdUpload ? "SD card upload cancelled" : "Print cancelled");
	}

	private string Eta(JobDto j) => j.Status switch
	{
		JobStatus.Printing or JobStatus.Paused when j.Remaining is { } r => (Time.GetLocalNow() + r).ToString("HH:mm"),
		JobStatus.Completed or JobStatus.Cancelled or JobStatus.Failed => "Done",
		_ => "—"
	};

	public override void Dispose()
	{
		_ticker?.Dispose();
		base.Dispose();
	}
}
