@page "/control"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inherits PrinterComponent

<PageTitle>Control · PrintDeck</PageTitle>

<header class="page-head">
	<h1>Control</h1>
	@if (_state == PrinterState.Printing)
	{
		<p class="banner banner-warn">Motion is locked while printing. Pause the print to move the printer.</p>
	}
	else if (!_state.IsConnected())
	{
		<p class="banner">Connect the printer to use these controls.</p>
	}
</header>

<fieldset class="control-grid" disabled="@(!_canMove)">
	<section class="card">
		<header class="card-head">
			<h2>Move</h2>
			<div class="seg" role="group" aria-label="Step size">
				@foreach (double s in _steps)
				{
					<button type="button" class="seg-btn @(_step == s ? "is-active" : "")" @onclick="() => _step = s">@s mm</button>
				}
			</div>
		</header>

		<div class="jog">
			<div class="jog-xy">
				<span></span>
				<button class="jog-btn" title="Y+" @onclick="() => Jog(Axis.Y, 1)"><Icon Name="up" /><small>Y</small></button>
				<span></span>
				<button class="jog-btn" title="X−" @onclick="() => Jog(Axis.X, -1)"><Icon Name="left" /><small>X</small></button>
				<button class="jog-btn jog-home" title="Home X and Y" @onclick="() => Run(new HomeCommand(Axis.X | Axis.Y))"><Icon Name="home" /></button>
				<button class="jog-btn" title="X+" @onclick="() => Jog(Axis.X, 1)"><Icon Name="right" /><small>X</small></button>
				<span></span>
				<button class="jog-btn" title="Y−" @onclick="() => Jog(Axis.Y, -1)"><Icon Name="down" /><small>Y</small></button>
				<span></span>
			</div>
			<div class="jog-z">
				<button class="jog-btn" title="Z+" @onclick="() => Jog(Axis.Z, 1)"><Icon Name="up" /><small>Z</small></button>
				<button class="jog-btn jog-home" title="Home Z" @onclick="() => Run(new HomeCommand(Axis.Z))"><Icon Name="home" /></button>
				<button class="jog-btn" title="Z−" @onclick="() => Jog(Axis.Z, -1)"><Icon Name="down" /><small>Z</small></button>
			</div>
		</div>

		<div class="actions">
			<button class="btn" @onclick="() => Run(new HomeCommand(Axis.All))"><Icon Name="home" Size="16" /> Home all</button>
			<button class="btn btn-ghost" @onclick='() => Run(new MotorsOffCommand(), "Motors off")'><Icon Name="power" Size="16" /> Motors off</button>
		</div>
	</section>

	<section class="card">
		<header class="card-head"><h2>Extruder</h2></header>
		<label class="field">
			<span>Length (mm)</span>
			<input class="input input-num" type="number" min="1" max="200" step="1" @bind="_extrude" />
		</label>
		<div class="actions">
			<button class="btn" @onclick="() => Run(new ExtrudeCommand(_extrude))"><Icon Name="down" Size="16" /> Extrude</button>
			<button class="btn btn-ghost" @onclick="() => Run(new ExtrudeCommand(-_extrude))"><Icon Name="up" Size="16" /> Retract</button>
		</div>
		<p class="muted small">Needs the hotend at 170 °C or more</p>
	</section>

	<section class="card">
		<header class="card-head">
			<h2>Part fan</h2>
			<span class="value">@_fan%</span>
		</header>
		<input class="range" type="range" min="0" max="100" step="5" @bind="_fan" @bind:event="oninput" @onchange="FanChanged" aria-label="Fan speed" />
		<div class="actions">
			<button class="btn btn-sm btn-ghost" @onclick="() => SetFan(0)">Off</button>
			<button class="btn btn-sm btn-ghost" @onclick="() => SetFan(50)">50%</button>
			<button class="btn btn-sm btn-ghost" @onclick="() => SetFan(100)">100%</button>
		</div>
	</section>
</fieldset>

@code {
	private static readonly double[] _steps = [0.1, 1, 10, 100];
	private PrinterState _state;
	private double _step = 10;
	private double _extrude = 5;
	private int _fan;

	private bool _canMove => _state is PrinterState.Operational or PrinterState.Paused;

	protected override PrinterChange Interests => PrinterChange.State;

	protected override async Task RefreshAsync() => _state = (await Mediator.Send(new GetPrinterStatusQuery())).State;

	private Task Jog(Axis axis, int direction) => Run(new JogCommand(axis, direction * _step));

	private Task FanChanged(ChangeEventArgs e) => SetFan(int.Parse(e.Value?.ToString() ?? "0"));

	private async Task SetFan(int percent)
	{
		_fan = percent;
		await Run(new SetFanCommand(percent));
	}
}
