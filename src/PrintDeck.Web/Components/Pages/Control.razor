@page "/control"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inherits PrinterComponent
@inject IJSRuntime JS
@inject IStringLocalizer<Control> L

<PageTitle>@Shared["PageTitle", L["Title"]]</PageTitle>

<header class="page-head">
	<h1>@L["Title"]</h1>
	@if (_state == PrinterState.Printing)
	{
		<p class="banner banner-warn">@L["LockedWhilePrinting"]</p>
	}
	else if (!_state.IsConnected())
	{
		<p class="banner">@L["ConnectFirst"]</p>
	}
</header>

<fieldset class="control-grid" disabled="@(!_canMove)">
	<section class="card">
		<header class="card-head">
			<h2>@L["Move"]</h2>
			<div class="seg" role="group" aria-label="@L["StepSize"]">
				@foreach (double s in _steps)
				{
					<button type="button" class="seg-btn @(_step == s ? "is-active" : "")" @onclick="() => _step = s">@s mm</button>
				}
			</div>
		</header>

		<div class="jog">
			<div class="jog-xy">
				<span></span>
				<button class="jog-btn" title="Y+" @onclick="() => Jog(Axis.Y, 1)"><Icon Name="up" /><small>Y</small></button>
				<span></span>
				<button class="jog-btn" title="X−" @onclick="() => Jog(Axis.X, -1)"><Icon Name="left" /><small>X</small></button>
				<button class="jog-btn jog-home" title="@L["HomeXY"]" @onclick="() => Run(new HomeCommand(Axis.X | Axis.Y))"><Icon Name="home" /></button>
				<button class="jog-btn" title="X+" @onclick="() => Jog(Axis.X, 1)"><Icon Name="right" /><small>X</small></button>
				<span></span>
				<button class="jog-btn" title="Y−" @onclick="() => Jog(Axis.Y, -1)"><Icon Name="down" /><small>Y</small></button>
				<span></span>
			</div>
			<div class="jog-z">
				<button class="jog-btn" title="Z+" @onclick="() => Jog(Axis.Z, 1)"><Icon Name="up" /><small>Z</small></button>
				<button class="jog-btn jog-home" title="@L["HomeZ"]" @onclick="() => Run(new HomeCommand(Axis.Z))"><Icon Name="home" /></button>
				<button class="jog-btn" title="Z−" @onclick="() => Jog(Axis.Z, -1)"><Icon Name="down" /><small>Z</small></button>
			</div>
		</div>

		<div class="actions">
			<button class="btn" @onclick="() => Run(new HomeCommand(Axis.All))"><Icon Name="home" Size="16" /> @L["HomeAll"]</button>
			<button class="btn btn-ghost" @onclick='() => Run(new MotorsOffCommand(), L["MotorsOff"])'><Icon Name="power" Size="16" /> @L["MotorsOff"]</button>
		</div>
		<p class="muted small key-hint">@L.Html("KeyboardHtml")</p>
	</section>

	<section class="card">
		<header class="card-head"><h2>@L["Extruder"]</h2></header>
		<label class="field">
			<span>@L["Length"]</span>
			<input class="input input-num" type="number" min="1" max="200" step="1" @bind="_extrude" />
		</label>
		<div class="actions">
			<button class="btn" @onclick="() => Run(new ExtrudeCommand(_extrude))"><Icon Name="down" Size="16" /> @L["Extrude"]</button>
			<button class="btn btn-ghost" @onclick="() => Run(new ExtrudeCommand(-_extrude))"><Icon Name="up" Size="16" /> @L["Retract"]</button>
		</div>
		<p class="muted small">@L["NeedsHeat"]</p>
	</section>

	<section class="card">
		<header class="card-head">
			<h2>@L["PartFan"]</h2>
			<span class="value">@_fan%</span>
		</header>
		<input class="range" type="range" min="0" max="100" step="5" @bind="_fan" @bind:event="oninput" @onchange="FanChanged" aria-label="@L["FanSpeed"]" />
		<div class="actions">
			<button class="btn btn-sm btn-ghost" @onclick="() => SetFan(0)">@L["FanOff"]</button>
			<button class="btn btn-sm btn-ghost" @onclick="() => SetFan(50)">50%</button>
			<button class="btn btn-sm btn-ghost" @onclick="() => SetFan(100)">100%</button>
		</div>
	</section>
</fieldset>

@* Outside the fieldset: speed and flow stay adjustable while printing. *@
<div class="control-grid control-more">
	<SpeedFlowPanel />
	@if (_buttons.Count > 0)
	{
		<section class="card" aria-labelledby="custom-title">
			<header class="card-head"><h2 id="custom-title">@L["Custom"]</h2></header>
			<div class="custom-buttons">
				@for (int i = 0; i < _buttons.Count; i++)
				{
					int index = i;
					CustomButton b = _buttons[index];
					bool allowed = b.IdleOnly ? _canMove : _state.IsConnected();
					bool armed = _armed == index;
					<button type="button" class="btn @(armed ? "btn-primary" : "")" disabled="@(!allowed)" @key="(index, b.Label)"
							title="@(allowed ? b.Gcode : b.IdleOnly && _state.IsBusy() ? L["NotWhilePrinting"] : L["ConnectPrinterFirst"])"
							@onclick="() => PressAsync(index, b)">
						@if (b.Icon is { } icon)
						{
							<Icon Name="@icon" Size="16" />
						}
						@(armed ? L["SendButton", b.Label] : b.Label)
					</button>
				}
			</div>
			<p class="muted small">@L.Html("ChangeButtonsHtml")</p>
		</section>
	}
</div>

@code {
	private static readonly double[] _steps = [0.1, 1, 10, 100];
	private PrinterState _state;
	private double _step = 10;
	private double _extrude = 5;
	private int _fan;
	private IReadOnlyList<CustomButton> _buttons = [];
	private int? _armed;

	private bool _canMove => _state is PrinterState.Operational or PrinterState.Paused;

	private IJSObjectReference? _keysModule;
	private IJSObjectReference? _keys;
	private DotNetObjectReference<Control>? _self;

	protected override PrinterChange Interests => PrinterChange.State | PrinterChange.Settings;

	protected override async Task RefreshAsync()
	{
		_state = (await Mediator.Send(new GetPrinterStatusQuery())).State;
		IReadOnlyList<CustomButton> buttons = (await Mediator.Send(new GetSettingsQuery())).CustomButtons;
		if (!buttons.SequenceEqual(_buttons)) _armed = null;
		_buttons = buttons;
	}

	/// <summary>A button that asks first sends on the second click.</summary>
	private async Task PressAsync(int index, CustomButton b)
	{
		if (b.Confirm && _armed != index)
		{
			_armed = index;
			return;
		}
		_armed = null;
		await Run(new RunCustomButtonCommand(index, b.Label), L["SentButton", b.Label]);
	}

	private Task Jog(Axis axis, int direction) => Run(new JogCommand(axis, direction * _step));

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender) return;
		try
		{
			_self = DotNetObjectReference.Create(this);
			_keysModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/control/keyboard-jog.js");
			_keys = await _keysModule.InvokeAsync<IJSObjectReference>("attach", _self, _steps.Length);
		}
		catch (JSDisconnectedException) { }
	}

	/// <summary>A key from keyboard-jog.ts: "X+", "Z-", "home-xy", "home-z" or "step-N".</summary>
	[JSInvokable]
	public async Task OnJogKey(string key)
	{
		if (key.StartsWith("step-", StringComparison.Ordinal))
		{
			if (int.TryParse(key.AsSpan(5), out int i) && i >= 0 && i < _steps.Length) _step = _steps[i];
			StateHasChanged();
			return;
		}
		if (!_canMove) return; // same rule as the disabled buttons; the server refuses anyway

		await (key switch
		{
			"X+" => Jog(Axis.X, 1),
			"X-" => Jog(Axis.X, -1),
			"Y+" => Jog(Axis.Y, 1),
			"Y-" => Jog(Axis.Y, -1),
			"Z+" => Jog(Axis.Z, 1),
			"Z-" => Jog(Axis.Z, -1),
			"home-xy" => Run(new HomeCommand(Axis.X | Axis.Y)),
			"home-z" => Run(new HomeCommand(Axis.Z)),
			_ => Task.CompletedTask
		});
	}

	public override void Dispose()
	{
		IJSObjectReference? keys = _keys, module = _keysModule;
		DotNetObjectReference<Control>? self = _self;
		_keys = _keysModule = null;
		_self = null;
		_ = Task.Run(async () =>
		{
			try
			{
				if (keys is not null) { await keys.InvokeVoidAsync("dispose"); await keys.DisposeAsync(); }
				if (module is not null) await module.DisposeAsync();
			}
			catch (JSDisconnectedException) { }
			catch (ObjectDisposedException) { }
			finally { self?.Dispose(); }
		});
		base.Dispose();
	}

	private Task FanChanged(ChangeEventArgs e) => SetFan(int.Parse(e.Value?.ToString() ?? "0"));

	private async Task SetFan(int percent)
	{
		_fan = percent;
		await Run(new SetFanCommand(percent));
	}
}
