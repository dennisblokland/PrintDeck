@page "/users"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject IMediator Mediator
@inject ToastService Toasts
@inject IStringLocalizer<Users> L
@inject IStringLocalizer<SharedText> Shared

<PageTitle>@Shared["PageTitle", L["Title"]]</PageTitle>

<header class="page-head">
	<h1>@L["Title"]</h1>
	<p class="muted">@L["Intro"]</p>
</header>

<div class="users">
	<section class="card">
		<header class="card-head"><h2>@L["Accounts"]</h2><span class="value">@_users.Count</span></header>
		<ul class="user-list">
			@foreach (UserAccount u in _users)
			{
				bool me = IsMe(u);
				<li class="user-row">
					<div class="user-who">
						<Icon Name="user" Size="16" />
						<strong>@u.UserName</strong>
						@if (me)
						{
							<span class="chip">@L["You"]</span>
						}
						@if (u.IsLockedOut)
						{
							<span class="chip chip-failed" title="@L["LockedOutTitle"]">@L["LockedOut"]</span>
						}
					</div>
					<select class="input input-role" aria-label="@L["RoleFor", u.UserName]" disabled="@me"
							title="@(me ? L["OwnRole"].Value : null)" value="@u.Role" @onchange="e => SetRoleAsync(u, e)">
						<option value="@UserRole.Admin">@Shared["RoleAdmin"]</option>
						<option value="@UserRole.Viewer">@Shared["RoleViewer"]</option>
					</select>
					<button class="btn btn-sm btn-ghost" @onclick="() => StartReset(u)"><Icon Name="key" Size="14" /> @L["ResetPassword"]</button>
					<button class="icon-btn icon-btn-danger @(_confirmDelete == u.UserName ? "is-armed" : "")" disabled="@me"
							title="@(me ? L["DeleteSelf"] : _confirmDelete == u.UserName ? Shared["ClickAgainToDelete"] : Shared["Delete"])"
							@onclick="() => DeleteAsync(u)">
						<Icon Name="@(_confirmDelete == u.UserName ? "check" : "trash")" Size="16" />
					</button>
				</li>
				@if (_resetFor == u.UserName)
				{
					<li>
						<form class="user-reset" @onsubmit="ResetAsync" @onsubmit:preventDefault>
							<input class="input" type="password" autocomplete="new-password" placeholder="@L["NewPasswordFor", u.UserName]"
								   aria-label="@L["NewPasswordFor", u.UserName]" @bind="_resetPassword" />
							<button class="btn btn-sm btn-primary" type="submit">@L["SetPassword"]</button>
							<button class="btn btn-sm btn-ghost" type="button" @onclick="() => _resetFor = null">@Shared["Cancel"]</button>
						</form>
					</li>
				}
			}
		</ul>
	</section>

	<section class="card">
		<header class="card-head"><h2>@L["AddSomeone"]</h2></header>
		<form class="user-add" @onsubmit="AddAsync" @onsubmit:preventDefault>
			<label class="field"><span>@Shared["Username"]</span><input class="input" autocomplete="off" @bind="_newName" /></label>
			<label class="field"><span>@Shared["Password"]</span><input class="input" type="password" autocomplete="new-password" @bind="_newPassword" /></label>
			<label class="field">
				<span>@L["Role"]</span>
				<select class="input" @bind="_newRole">
					<option value="@UserRole.Viewer">@Shared["RoleViewer"]</option>
					<option value="@UserRole.Admin">@Shared["RoleAdmin"]</option>
				</select>
			</label>
			<button class="btn btn-primary" type="submit"><Icon Name="check" Size="16" /> @L["AddUser"]</button>
		</form>
		<p class="muted small">@L["PasswordHint"]</p>
	</section>
</div>

@code {
	[CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

	private IReadOnlyList<UserAccount> _users = [];
	private string? _me;
	private string? _confirmDelete;
	private string? _resetFor;
	private string _resetPassword = "";
	private string _newName = "";
	private string _newPassword = "";
	private UserRole _newRole = UserRole.Viewer;

	protected override async Task OnInitializedAsync()
	{
		_me = (await AuthenticationState).User.Identity?.Name;
		await LoadAsync();
	}

	private async Task LoadAsync() => _users = await Mediator.Send(new ListUsersQuery());

	private bool IsMe(UserAccount u) => string.Equals(u.UserName, _me, StringComparison.OrdinalIgnoreCase);

	private async Task<bool> Send(ICommand<Result> command, string success)
	{
		Result result = await Mediator.Send(command);
		if (result.IsSuccess) Toasts.Success(success);
		else Toasts.Error(result.Error ?? Shared["SomethingWentWrong"]);
		await LoadAsync();
		return result.IsSuccess;
	}

	private async Task SetRoleAsync(UserAccount u, ChangeEventArgs e)
	{
		if (!Enum.TryParse(e.Value?.ToString(), out UserRole role)) return;
		await Send(new SetUserRoleCommand(u.UserName, role), (role == UserRole.Admin ? L["NowAdmin", u.UserName] : L["NowViewer", u.UserName]));
	}

	private void StartReset(UserAccount u)
	{
		_resetFor = u.UserName;
		_resetPassword = "";
	}

	private async Task ResetAsync()
	{
		if (_resetFor is not { } name) return;
		if (await Send(new ResetUserPasswordCommand(name, _resetPassword), L["PasswordSet", name]))
			_resetFor = null;
		_resetPassword = "";
	}

	private async Task DeleteAsync(UserAccount u)
	{
		if (_confirmDelete != u.UserName)
		{
			_confirmDelete = u.UserName;
			return;
		}
		_confirmDelete = null;
		await Send(new DeleteUserCommand(u.UserName), L["Deleted", u.UserName]);
	}

	private async Task AddAsync()
	{
		if (await Send(new CreateUserCommand(_newName, _newPassword, _newRole), L["Added", _newName.Trim()]))
		{
			_newName = "";
			_newRole = UserRole.Viewer;
		}
		_newPassword = "";
	}
}
