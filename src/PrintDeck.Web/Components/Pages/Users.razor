@page "/users"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inject IMediator Mediator
@inject ToastService Toasts

<PageTitle>Users · PrintDeck</PageTitle>

<header class="page-head">
	<h1>Users</h1>
	<p class="muted">Admins run the printer and change settings. Viewers can watch the dashboard, camera, files and toolpaths.</p>
</header>

<div class="users">
	<section class="card">
		<header class="card-head"><h2>Accounts</h2><span class="value">@_users.Count</span></header>
		<ul class="user-list">
			@foreach (UserAccount u in _users)
			{
				bool me = IsMe(u);
				<li class="user-row">
					<div class="user-who">
						<Icon Name="user" Size="16" />
						<strong>@u.UserName</strong>
						@if (me)
						{
							<span class="chip">You</span>
						}
						@if (u.IsLockedOut)
						{
							<span class="chip chip-failed" title="Too many wrong passwords; resetting the password unlocks it">Locked out</span>
						}
					</div>
					<select class="input input-role" aria-label="@($"Role for {u.UserName}")" disabled="@me"
							title="@(me ? "You can't change your own role" : null)" value="@u.Role" @onchange="e => SetRoleAsync(u, e)">
						<option value="@UserRole.Admin">Admin</option>
						<option value="@UserRole.Viewer">Viewer</option>
					</select>
					<button class="btn btn-sm btn-ghost" @onclick="() => StartReset(u)"><Icon Name="key" Size="14" /> Reset password</button>
					<button class="icon-btn icon-btn-danger @(_confirmDelete == u.UserName ? "is-armed" : "")" disabled="@me"
							title="@(me ? "You can't delete yourself" : _confirmDelete == u.UserName ? "Click again to delete" : "Delete")"
							@onclick="() => DeleteAsync(u)">
						<Icon Name="@(_confirmDelete == u.UserName ? "check" : "trash")" Size="16" />
					</button>
				</li>
				@if (_resetFor == u.UserName)
				{
					<li>
						<form class="user-reset" @onsubmit="ResetAsync" @onsubmit:preventDefault>
							<input class="input" type="password" autocomplete="new-password" placeholder="New password for @u.UserName"
								   aria-label="@($"New password for {u.UserName}")" @bind="_resetPassword" />
							<button class="btn btn-sm btn-primary" type="submit">Set password</button>
							<button class="btn btn-sm btn-ghost" type="button" @onclick="() => _resetFor = null">Cancel</button>
						</form>
					</li>
				}
			}
		</ul>
	</section>

	<section class="card">
		<header class="card-head"><h2>Add someone</h2></header>
		<form class="user-add" @onsubmit="AddAsync" @onsubmit:preventDefault>
			<label class="field"><span>Username</span><input class="input" autocomplete="off" @bind="_newName" /></label>
			<label class="field"><span>Password</span><input class="input" type="password" autocomplete="new-password" @bind="_newPassword" /></label>
			<label class="field">
				<span>Role</span>
				<select class="input" @bind="_newRole">
					<option value="@UserRole.Viewer">Viewer</option>
					<option value="@UserRole.Admin">Admin</option>
				</select>
			</label>
			<button class="btn btn-primary" type="submit"><Icon Name="check" Size="16" /> Add user</button>
		</form>
		<p class="muted small">Passwords need at least 8 characters. Share it with them; they can change it under their name in the sidebar.</p>
	</section>
</div>

@code {
	[CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

	private IReadOnlyList<UserAccount> _users = [];
	private string? _me;
	private string? _confirmDelete;
	private string? _resetFor;
	private string _resetPassword = "";
	private string _newName = "";
	private string _newPassword = "";
	private UserRole _newRole = UserRole.Viewer;

	protected override async Task OnInitializedAsync()
	{
		_me = (await AuthenticationState).User.Identity?.Name;
		await LoadAsync();
	}

	private async Task LoadAsync() => _users = await Mediator.Send(new ListUsersQuery());

	private bool IsMe(UserAccount u) => string.Equals(u.UserName, _me, StringComparison.OrdinalIgnoreCase);

	private async Task<bool> Send(ICommand<Result> command, string success)
	{
		Result result = await Mediator.Send(command);
		if (result.IsSuccess) Toasts.Success(success);
		else Toasts.Error(result.Error ?? "Something went wrong.");
		await LoadAsync();
		return result.IsSuccess;
	}

	private async Task SetRoleAsync(UserAccount u, ChangeEventArgs e)
	{
		if (!Enum.TryParse(e.Value?.ToString(), out UserRole role)) return;
		await Send(new SetUserRoleCommand(u.UserName, role), $"{u.UserName} is now {(role == UserRole.Admin ? "an admin" : "a viewer")}");
	}

	private void StartReset(UserAccount u)
	{
		_resetFor = u.UserName;
		_resetPassword = "";
	}

	private async Task ResetAsync()
	{
		if (_resetFor is not { } name) return;
		if (await Send(new ResetUserPasswordCommand(name, _resetPassword), $"New password set for {name}"))
			_resetFor = null;
		_resetPassword = "";
	}

	private async Task DeleteAsync(UserAccount u)
	{
		if (_confirmDelete != u.UserName)
		{
			_confirmDelete = u.UserName;
			return;
		}
		_confirmDelete = null;
		await Send(new DeleteUserCommand(u.UserName), $"Deleted {u.UserName}");
	}

	private async Task AddAsync()
	{
		if (await Send(new CreateUserCommand(_newName, _newPassword, _newRole), $"Added {_newName.Trim()}"))
		{
			_newName = "";
			_newRole = UserRole.Viewer;
		}
		_newPassword = "";
	}
}
