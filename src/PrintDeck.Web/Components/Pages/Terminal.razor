@page "/terminal"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inherits PrinterComponent

<PageTitle>Terminal · PrintDeck</PageTitle>

<header class="page-head page-head-row">
	<h1>Terminal</h1>
	<div class="toolbar">
		<label class="toggle" title="Write every line to and from the printer to logs/serial.log">
			<input type="checkbox" checked="@_logs.SerialLogEnabled" @onchange="SetSerialLogAsync" />
			<span>Serial log to file</span>
		</label>
		<button class="btn btn-sm btn-ghost" @onclick="() => Run(new ClearTerminalCommand())"><Icon Name="trash" Size="14" /> Clear</button>
	</div>
</header>

<section class="card terminal-card">
	<div class="terminal-filters" role="group" aria-label="Hide lines">
		<span class="muted small">Hide</span>
		@foreach (TerminalFilter f in _filters)
		{
			<label class="toggle" title="@f.Pattern" @key="f.Name">
				<input type="checkbox" checked="@f.Enabled" @onchange="e => ToggleFilterAsync(f, e.Value is true)" />
				<span>@f.Name</span>
			</label>
		}
		@if (_filters.Count == 0)
		{
			<span class="muted small">nothing: no filters yet.</span>
		}
		<button class="btn btn-sm btn-ghost" @onclick="EditFilters"><Icon Name="sliders" Size="14" /> Edit filters</button>
	</div>
	<div class="terminal" role="log" aria-live="off">
		@* column-reverse keeps the view pinned to the newest line without JS *@
		<div class="terminal-inner">
			@foreach (TerminalEntry e in _entries)
			{
				<div class="tl tl-@e.Direction.ToString().ToLowerInvariant()" @key="e.Id">
					<time>@e.At.ToLocalTime().ToString("HH:mm:ss")</time>
					<span class="tl-dir">@(e.Direction switch { TerminalDirection.Sent => "›", TerminalDirection.Received => "‹", TerminalDirection.Error => "!", _ => "·" })</span>
					<span class="tl-text">@e.Text</span>
				</div>
			}
		</div>
	</div>

	<form class="terminal-input" @onsubmit="SendAsync" @onsubmit:preventDefault>
		<span class="prompt">›</span>
		<input class="input mono" placeholder="@(_connected ? "G-code, e.g. M114 — ↑/↓ for history" : "Connect to send commands")"
			   disabled="@(!_connected)" @bind="_command" @bind:event="oninput" @onkeydown="OnKey" autocomplete="off" spellcheck="false" />
		<button class="btn btn-primary" type="submit" disabled="@(!_connected || string.IsNullOrWhiteSpace(_command))"><Icon Name="send" Size="16" /> Send</button>
	</form>

	<div class="quick">
		@foreach ((string cmd, string label) in _quick)
		{
			<button class="btn btn-sm btn-ghost mono" disabled="@(!_connected)" title="@label" @onclick="() => Send(cmd)">@cmd</button>
		}
	</div>
</section>

@if (_editor is { } editor)
{
	<form class="card filters-card" aria-labelledby="filters-title" @onsubmit="SaveFiltersAsync" @onsubmit:preventDefault>
		<header class="card-head">
			<h2 id="filters-title">Terminal filters</h2>
			<button type="button" class="btn btn-sm btn-ghost" @onclick="() => editor.Add(new FilterRow())">Add filter</button>
		</header>
		<p class="muted small">
			Each filter hides the lines its pattern matches: a regular expression, not case-sensitive.
			Sent lines carry their line number and checksum, e.g. <code>N12 M105*39</code>, so match a command with
			<code>^(N\d+\s+)?M105</code>. Switch filters on and off above the terminal.
		</p>
		@if (editor.Count == 0)
		{
			<p class="muted small">No filters: the terminal shows every line.</p>
		}
		<div class="filter-rows">
			@foreach (FilterRow row in editor)
			{
				<div class="filter-row">
					<label class="toggle" title="On"><input type="checkbox" aria-label="Filter on" @bind="row.Enabled" /></label>
					<input class="input filter-name" placeholder="Name" maxlength="@TerminalFilter.MaxNameLength" aria-label="Filter name" @bind="row.Name" />
					<input class="input mono filter-pattern" placeholder="Pattern, e.g. ^echo:" maxlength="@TerminalFilter.MaxPatternLength"
						   aria-label="Filter pattern" spellcheck="false" autocomplete="off" @bind="row.Pattern" />
					<button type="button" class="icon-btn icon-btn-danger" title="Remove filter" @onclick="() => editor.Remove(row)"><Icon Name="x" Size="16" /></button>
				</div>
			}
		</div>
		<div class="form-actions">
			<button type="button" class="btn btn-ghost" title="Replace the list with PrintDeck's filters" @onclick="RestoreDefaults">Restore defaults</button>
			<button type="button" class="btn btn-ghost" @onclick="() => _editor = null">Cancel</button>
			<button class="btn btn-primary" type="submit"><Icon Name="check" Size="16" /> Save filters</button>
		</div>
	</form>
}

<section class="card logs-card" aria-labelledby="logs-title">
	<header class="card-head">
		<h2 id="logs-title">Log files</h2>
		<button class="icon-btn" title="Refresh list" @onclick="LoadLogsAsync"><Icon Name="refresh" Size="16" /></button>
	</header>
	@if (_logs.Files.Count == 0)
	{
		<p class="muted small">No log files yet.</p>
	}
	else
	{
		<ul class="log-list">
			@foreach (LogFile f in _logs.Files)
			{
				<li @key="f.Name">
					<span class="mono">@f.Name</span>
					<span class="muted small">@Format.Bytes(f.SizeBytes) · @Format.Ago(f.ModifiedAt, Time.GetUtcNow())</span>
					<a class="btn btn-sm btn-ghost" href="logs/@Uri.EscapeDataString(f.Name)" download="@f.Name"><Icon Name="down" Size="14" /> Download</a>
				</li>
			}
		</ul>
	}
</section>

@code {
	private static readonly (string, string)[] _quick =
	[
		("M114", "Report position"), ("M105", "Report temperatures"), ("M503", "Report settings"),
		("M119", "Endstop states"), ("M115", "Firmware info"), ("G28", "Home all axes")
	];

	private IReadOnlyList<TerminalEntry> _entries = [];
	private readonly List<string> _history = [];
	private int _historyIndex = -1;
	private IReadOnlyList<TerminalFilter> _filters = [];
	private List<FilterRow>? _editor;
	private bool _connected;
	private string _command = "";
	private LogsDto _logs = new(false, []);
	private bool _logsLoaded;

	protected override PrinterChange Interests => PrinterChange.Terminal | PrinterChange.State | PrinterChange.Settings;
	protected override TimeSpan Throttle => TimeSpan.FromMilliseconds(250);

	protected override async Task RefreshAsync()
	{
		_filters = (await Mediator.Send(new GetSettingsQuery())).TerminalFilters;
		_entries = await Mediator.Send(new GetTerminalLogQuery(400));
		_connected = (await Mediator.Send(new GetPrinterStatusQuery())).State.IsConnected();
		if (!_logsLoaded) await LoadLogsAsync();
	}

	private sealed class FilterRow
	{
		public string Name { get; set; } = "";
		public string Pattern { get; set; } = "";
		public bool Enabled { get; set; } = true;

		public static FilterRow From(TerminalFilter f) => new() { Name = f.Name, Pattern = f.Pattern, Enabled = f.Enabled };
		public TerminalFilter ToFilter() => new(Name, Pattern, Enabled);
	}

	private void EditFilters() => _editor = _filters.Select(FilterRow.From).ToList();

	private void RestoreDefaults() => _editor = TerminalFilter.Defaults.Select(FilterRow.From).ToList();

	private async Task ToggleFilterAsync(TerminalFilter filter, bool on)
	{
		List<TerminalFilter> filters = _filters.Select(f => f == filter ? f with { Enabled = on } : f).ToList();
		if (!await Run(new UpdateTerminalFiltersCommand(filters))) return;
		if (_editor?.FirstOrDefault(r => r.Name == filter.Name && r.Pattern == filter.Pattern) is { } row) row.Enabled = on;
		await ReloadAsync();
	}

	private async Task SaveFiltersAsync()
	{
		if (_editor is null) return;
		if (!await Run(new UpdateTerminalFiltersCommand(_editor.Select(r => r.ToFilter()).ToList()), "Filters saved")) return;
		_editor = null;
		await ReloadAsync();
	}

	private async Task LoadLogsAsync()
	{
		_logs = await Mediator.Send(new GetLogsQuery());
		_logsLoaded = true;
	}

	private async Task SetSerialLogAsync(ChangeEventArgs e)
	{
		bool on = e.Value is true;
		await Run(new SetSerialLogCommand(on), on ? "Serial log on: logs/serial.log" : "Serial log off");
		await LoadLogsAsync();
	}

	private async Task SendAsync()
	{
		string text = _command.Trim();
		if (text.Length == 0) return;
		if (_history.LastOrDefault() != text) _history.Add(text);
		_historyIndex = -1;
		_command = "";
		await Send(text);
	}

	private Task Send(string text) => Run(new SendGcodeCommand(text));

	private void OnKey(KeyboardEventArgs e)
	{
		if (_history.Count == 0) return;
		if (e.Key == "ArrowUp")
		{
			_historyIndex = _historyIndex < 0 ? _history.Count - 1 : Math.Max(0, _historyIndex - 1);
			_command = _history[_historyIndex];
		}
		else if (e.Key == "ArrowDown" && _historyIndex >= 0)
		{
			_historyIndex++;
			if (_historyIndex >= _history.Count) { _historyIndex = -1; _command = ""; }
			else _command = _history[_historyIndex];
		}
	}
}
