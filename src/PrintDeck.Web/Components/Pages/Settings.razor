@page "/settings"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inherits PrinterComponent
@inject NavigationManager Nav

<PageTitle>Settings · PrintDeck</PageTitle>

<header class="page-head"><h1>Settings</h1></header>

@if (_settings is not null && _profile is not null && _host is not null)
{
	<div class="settings">
		<section class="card">
			<header class="card-head">
				<h2>Printer profiles</h2>
				<button type="button" class="btn btn-sm btn-ghost" @onclick="NewProfile">New profile</button>
			</header>
			<ul class="profile-list">
				@foreach (PrinterProfile p in _settings.Profiles)
				{
					bool active = p.Id == _settings.ActiveProfileId;
					<li class="profile-row @(p.Id == _profile.Id ? "is-editing" : "")">
						<button type="button" class="profile-name" @onclick="() => Edit(p)">
							<span class="profile-title">
								<strong>@p.Name</strong>
								@if (active)
								{
									<span class="chip chip-printing">Active</span>
								}
							</span>
							<small>@Summary(p)</small>
						</button>
						@if (!active)
						{
							<button type="button" class="btn btn-sm btn-ghost" disabled="@_busy"
									title="@(_busy ? "Finish the print first" : null)" @onclick="() => SelectAsync(p)">Use</button>
						}
						<button type="button" class="icon-btn" title="Duplicate" @onclick="() => Duplicate(p)"><Icon Name="copy" Size="16" /></button>
						<button type="button" class="icon-btn icon-btn-danger @(_confirmDelete == p.Id ? "is-armed" : "")" disabled="@active"
								title="@(active ? "The active profile can't be deleted" : _confirmDelete == p.Id ? "Click again to delete" : "Delete")"
								@onclick="() => DeleteAsync(p)">
							<Icon Name="@(_confirmDelete == p.Id ? "check" : "trash")" Size="16" />
						</button>
					</li>
				}
			</ul>
			<p class="muted small">Build volume, extruders and heated bed belong to a profile. Switch profiles when you move PrintDeck to another printer.</p>
		</section>

		<form class="card" @onsubmit="SaveProfileAsync" @onsubmit:preventDefault>
			<header class="card-head">
				<h2>@(_profile.Id.Length == 0 ? "New profile" : $"Edit {_profileName}")</h2>
			</header>
			<div class="form-grid">
				<label class="field span-2"><span>Name</span><input class="input" maxlength="64" @bind="_profile.Name" /></label>
				<label class="field"><span>Bed width (mm)</span><input class="input" type="number" @bind="_profile.BedWidth" /></label>
				<label class="field"><span>Bed depth (mm)</span><input class="input" type="number" @bind="_profile.BedDepth" /></label>
				<label class="field"><span>Max height (mm)</span><input class="input" type="number" @bind="_profile.MaxHeight" /></label>
				<label class="field"><span>Extruders</span><input class="input" type="number" min="1" max="8" @bind="_profile.ExtruderCount" /></label>
				<label class="toggle span-2"><input type="checkbox" @bind="_profile.HasHeatedBed" /><span>Heated bed</span></label>
				<label class="field"><span>Jog XY (mm/min)</span><input class="input" type="number" @bind="_profile.JogFeedrateXY" /></label>
				<label class="field"><span>Jog Z (mm/min)</span><input class="input" type="number" @bind="_profile.JogFeedrateZ" /></label>
				<label class="field"><span>Extrude (mm/min)</span><input class="input" type="number" @bind="_profile.ExtrudeFeedrate" /></label>
			</div>
			<div class="form-actions">
				@if (_profile.Id.Length == 0)
				{
					<button type="button" class="btn btn-ghost" @onclick="() => Edit(_settings.ActiveProfile)">Cancel</button>
				}
				<button class="btn btn-primary" type="submit"><Icon Name="check" Size="16" /> @(_profile.Id.Length == 0 ? "Add profile" : "Save profile")</button>
			</div>
		</form>

		<form class="settings-host" @onsubmit="SaveHostAsync" @onsubmit:preventDefault>
			<section class="card">
				<header class="card-head">
					<h2>Temperature presets</h2>
					<button type="button" class="btn btn-sm btn-ghost" @onclick="() => _host.Presets.Add(new PresetRow())">Add preset</button>
				</header>
				<div class="preset-rows">
					@foreach (PresetRow p in _host.Presets)
					{
						<div class="preset-row">
							<input class="input" placeholder="Name" aria-label="Preset name" @bind="p.Name" />
							<label class="field-inline"><Icon Name="flame" Size="14" /><input class="input input-num" type="number" aria-label="Hotend" @bind="p.Hotend" />°</label>
							<label class="field-inline"><Icon Name="bed" Size="14" /><input class="input input-num" type="number" aria-label="Bed" @bind="p.Bed" />°</label>
							<button type="button" class="icon-btn icon-btn-danger" title="Remove" @onclick="() => _host.Presets.Remove(p)"><Icon Name="x" Size="16" /></button>
						</div>
					}
				</div>
			</section>

			<section class="card">
				<header class="card-head"><h2>Connection</h2></header>
				<label class="toggle">
					<input type="checkbox" @bind="_host.AutoConnect" />
					<span>Connect automatically</span>
				</label>
				<p class="muted small">
					@if (_settings.LastPort is { } lastPort)
					{
						<text>Connects to <code>@lastPort</code> at @_settings.DefaultBaudRate baud, the last port used, </text>
					}
					else
					{
						<text>Connects to the last port used, once you have connected by hand, </text>
					}
					when PrintDeck starts and whenever the port appears, for example when the printer is switched on.
					After a failed attempt it waits until the port disappears and comes back.
				</p>
			</section>

			<section class="card">
				<header class="card-head"><h2>Printer screen</h2></header>
				<label class="toggle">
					<input type="checkbox" @bind="_host.ShowProgressOnPrinter" />
					<span>Show progress, time left and layer on the printer's screen</span>
				</label>
				<p class="muted small">
					Sends <code>M73</code> and <code>M117</code> while PrintDeck streams a print.
					Files that already contain <code>M73</code> (PrusaSlicer, OrcaSlicer) keep their own.
				</p>
			</section>

			<section class="card">
				<header class="card-head"><h2>Camera</h2></header>
				<label class="field"><span>MJPEG stream URL</span>
					<input class="input" placeholder="http://printer.local:8080/?action=stream" @bind="_host.WebcamStreamUrl" />
				</label>
				<label class="field"><span>Snapshot URL</span>
					<span class="field-row">
						<input class="input" placeholder="http://printer.local:8080/?action=snapshot" @bind="_host.WebcamSnapshotUrl" />
						<button type="button" class="btn btn-ghost" disabled="@_testingSnapshot" @onclick="TestSnapshotAsync">@(_testingSnapshot ? "Testing…" : "Test")</button>
					</span>
				</label>
				<div class="camera-options">
					<label class="field-inline">Rotate
						<select class="input" aria-label="Rotate the picture" @bind="_host.WebcamRotation">
							@foreach (CameraRotation r in Enum.GetValues<CameraRotation>())
							{
								<option value="@r">@((int)r)°</option>
							}
						</select>
					</label>
					<label class="toggle"><input type="checkbox" @bind="_host.WebcamFlipHorizontal" /><span>Flip horizontally</span></label>
					<label class="toggle"><input type="checkbox" @bind="_host.WebcamFlipVertical" /><span>Flip vertically</span></label>
				</div>
				@if (_testSnapshot is { } shot)
				{
					<div class="camera-test">
						<div class="webcam">
							<img src="data:@shot.ContentType;base64,@Convert.ToBase64String(shot.Content)" alt="Test snapshot"
								 style="@CameraView.ImageStyle(_host.WebcamRotation, _host.WebcamFlipHorizontal, _host.WebcamFlipVertical)" />
						</div>
					</div>
				}
				<p class="muted small">
					The snapshot is a single still image, fetched by PrintDeck. The dashboard shows it, refreshed every few seconds,
					when there is no stream. Rotate and flip apply to both.
				</p>
			</section>

			<div class="save-bar">
				<button class="btn btn-primary" type="submit"><Icon Name="check" Size="16" /> Save settings</button>
			</div>
		</form>

		@if (_controls is { } cam)
		{
			<section class="card settings-wide" aria-labelledby="controls-title">
				<header class="card-head">
					<h2 id="controls-title">Camera controls</h2>
					@if (cam.Controls.Count > 0)
					{
						<button type="button" class="btn btn-sm btn-ghost" @onclick="ResetControlsAsync"><Icon Name="refresh" Size="14" /> Reset to defaults</button>
					}
				</header>
				<label class="field camera-device"><span>Camera</span>
					<select class="input" value="@(cam.Device ?? "")" @onchange="SelectCameraAsync">
						<option value="">None</option>
						@foreach (string d in cam.Devices)
						{
							<option value="@d">@(d == "VIRTUAL" ? "VIRTUAL (pretend webcam)" : d)</option>
						}
						@if (cam.Device is { } chosen && !cam.Devices.Contains(chosen))
						{
							<option value="@chosen">@chosen (not connected)</option>
						}
					</select>
				</label>
				@if (cam.Error is { } error)
				{
					<p class="auth-error" role="alert">@error</p>
				}
				@if (cam.Controls.Count > 0)
				{
					<div class="camera-controls">
						@foreach (CameraControl c in cam.Controls)
						{
							<div class="camera-control @(c.Inactive ? "is-inactive" : "")" @key="c.Name"
								 title="@(c.Inactive ? "Set by the camera's automatic mode; switch that off first" : null)">
								@switch (c.Type)
								{
									case CameraControlType.Integer:
										long shown = _sliding.TryGetValue(c.Name, out long v) ? v : c.Value;
										<label class="camera-control-head" for="ctl-@c.Name"><span>@c.Label</span><output class="mono">@shown</output></label>
										<input id="ctl-@c.Name" class="range" type="range" min="@c.Min" max="@c.Max" step="@c.Step" value="@c.Value" disabled="@c.Inactive"
											   @oninput="e => Slide(c, e)" @onchange="e => SetControlAsync(c, e.Value)" />
										break;
									case CameraControlType.Boolean:
										<label class="toggle">
											<input type="checkbox" checked="@(c.Value != 0)" disabled="@c.Inactive" @onchange="e => SetControlAsync(c, e.Value is true ? 1 : 0)" />
											<span>@c.Label</span>
										</label>
										break;
									default:
										<label class="camera-control-head" for="ctl-@c.Name"><span>@c.Label</span></label>
										<select id="ctl-@c.Name" class="input" value="@c.Value" disabled="@c.Inactive" @onchange="e => SetControlAsync(c, e.Value)">
											@foreach (CameraMenuItem m in c.Menu)
											{
												<option value="@m.Value">@m.Label</option>
											}
										</select>
										break;
								}
							</div>
						}
					</div>
				}
				<p class="muted small">
					Brightness, focus, exposure and the other controls your camera offers, through <code>v4l2-ctl</code>
					(install <code>v4l-utils</code> on the host). Changes apply right away and are applied again when PrintDeck starts,
					since most cameras forget them when they lose power. Greyed-out controls follow an automatic mode; switch that off first.
				</p>
			</section>
		}

		@if (_scripts is { } scripts)
		{
			<form class="card settings-wide" aria-labelledby="scripts-title" @onsubmit="SaveScriptsAsync" @onsubmit:preventDefault>
				<header class="card-head"><h2 id="scripts-title">G-code scripts</h2></header>
				<div class="scripts-grid">
					<div class="scripts-pane">
						<div class="seg scripts-tabs" role="tablist" aria-label="Script">
							@for (int i = 0; i < ScriptSlots.Length; i++)
							{
								int slot = i;
								<button type="button" role="tab" aria-selected="@(slot == _scriptSlot)"
										class="seg-btn @(slot == _scriptSlot ? "is-active" : "")" @onclick="() => _scriptSlot = slot">
									@ScriptSlots[slot].Label@if (!string.IsNullOrWhiteSpace(scripts.Texts[slot])) { <span class="script-dot" title="Has commands"></span> }
								</button>
							}
						</div>
						<p class="muted small">@ScriptSlots[_scriptSlot].Hint</p>
						<textarea class="input mono" rows="9" spellcheck="false" aria-label="@ScriptSlots[_scriptSlot].Label script"
								  @bind="scripts.Texts[_scriptSlot]"></textarea>
						<p class="muted small">
							Include a snippet on its own line with <code>{% snippet 'disable_hotends' %}</code>.
							Scripts are taken when a print starts, for prints streamed by PrintDeck and prints from the SD card.
						</p>
					</div>

					<div class="scripts-pane">
						<div class="scripts-head">
							<h3 class="card-subhead">Snippets</h3>
							<button type="button" class="btn btn-sm btn-ghost" @onclick="() => scripts.Snippets.Add(new SnippetRow())">Add snippet</button>
						</div>
						@if (scripts.Snippets.Count == 0)
						{
							<p class="muted small">No snippets yet.</p>
						}
						@foreach (SnippetRow snippet in scripts.Snippets)
						{
							<div class="snippet-row">
								<div class="field-row">
									<input class="input mono" placeholder="name" aria-label="Snippet name" @bind="snippet.Name" />
									<button type="button" class="icon-btn icon-btn-danger" title="Remove snippet" @onclick="() => scripts.Snippets.Remove(snippet)"><Icon Name="x" Size="16" /></button>
								</div>
								<textarea class="input mono" rows="2" spellcheck="false" aria-label="Snippet G-code" @bind="snippet.Gcode"></textarea>
							</div>
						}
					</div>
				</div>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit"><Icon Name="check" Size="16" /> Save scripts</button>
				</div>
			</form>
		}

		<section class="card settings-wide" aria-labelledby="keys-title">
			<header class="card-head"><h2 id="keys-title">Slicer upload</h2></header>
			<p class="muted small">
				In OrcaSlicer, PrusaSlicer or Cura add a physical printer with host type <strong>OctoPrint</strong>,
				host <code>@Nav.BaseUri.TrimEnd('/')</code> and an API key. Give each slicer or integration its own app key,
				so you can revoke one without touching the others. A key acts as the account that made it, with that account's role.
			</p>
			@if (_newKey is not null)
			{
				<div class="new-key" role="status">
					<p><strong>@_newKeyName</strong>: copy this key now. PrintDeck keeps only a fingerprint of it and can't show it again.</p>
					<div class="field-row">
						<input class="input mono" readonly value="@_newKey" aria-label="New API key" />
						<button type="button" class="btn btn-ghost" @onclick="() => _newKey = null"><Icon Name="check" Size="16" /> Done</button>
					</div>
				</div>
			}
			@if (_keys.Count > 0)
			{
				<ul class="profile-list key-list">
					@foreach (ApiKeyInfo k in _keys)
					{
						bool armed = _confirmRevoke == k.Id;
						<li class="profile-row">
							<div class="key-name">
								<strong>@k.Name</strong>
								<small>…@k.Hint · @k.OwnerName · made @Format.Ago(k.CreatedAt, Time.GetUtcNow()) · @(k.LastUsedAt is { } used ? $"used {Format.Ago(used, Time.GetUtcNow())}" : "never used")</small>
							</div>
							<button type="button" class="btn btn-sm btn-danger @(armed ? "is-armed" : "")" title="@(armed ? "Click again to revoke" : null)"
									@onclick="() => RevokeKeyAsync(k)">
								<Icon Name="@(armed ? "check" : "x")" Size="14" /> @(armed ? "Confirm revoke" : "Revoke")
							</button>
						</li>
					}
				</ul>
			}
			<form class="field-row" @onsubmit="CreateKeyAsync" @onsubmit:preventDefault>
				<input class="input" maxlength="@ApiKeySecret.MaxNameLength" placeholder="Name, e.g. OrcaSlicer on the laptop" aria-label="Key name" @bind="_keyName" />
				<button class="btn btn-primary" type="submit" disabled="@_creatingKey"><Icon Name="key" Size="16" /> New app key</button>
			</form>

			<h3 class="card-subhead">Shared key</h3>
			@if (_settings.SharedApiKeyEnabled)
			{
				<p class="muted small">
					The single key from before app keys. Whoever holds it can upload and print as an admin.
					Once every slicer has its own key, turn it off.
				</p>
				<div class="field-row">
					<input class="input mono" readonly value="@_settings.ApiKey" aria-label="Shared API key" />
					<button type="button" class="btn btn-ghost" @onclick="RegenerateAsync"><Icon Name="refresh" Size="16" /> New key</button>
					<button type="button" class="btn btn-danger @(_confirmSharedOff ? "is-armed" : "")" @onclick="DisableSharedKeyAsync">
						<Icon Name="power" Size="16" /> @(_confirmSharedOff ? "Confirm: turn off" : "Turn off")
					</button>
				</div>
			}
			else
			{
				<p class="muted small">Off: only app keys sign in.</p>
				<button type="button" class="btn btn-ghost" @onclick="RegenerateAsync"><Icon Name="refresh" Size="16" /> Turn on with a new key</button>
			}
		</section>

		<section class="card" aria-labelledby="backup-title">
			<header class="card-head"><h2 id="backup-title">Backup</h2></header>
			<p class="muted small">
				One zip with the settings, printer profiles, API key and every uploaded file with its print history.
				Accounts are not included. Keep it private: it holds the API key.
			</p>
			<div class="system-actions">
				<a class="btn btn-ghost" href="backup" download><Icon Name="down" Size="16" /> Download backup</a>
				<label class="btn btn-ghost file-btn @(_restoring || _busy ? "is-disabled" : "")" title="@(_busy ? "Finish the print first" : null)">
					<InputFile OnChange="PickBackup" accept=".zip,application/zip" disabled="@(_restoring || _busy)" />
					<Icon Name="upload" Size="16" /> Restore…
				</label>
			</div>
			@if (_restoreFile is not null)
			{
				<div class="restore-confirm" role="alert">
					<p>
						Restore <strong>@_restoreFile.Name</strong> (@Format.Bytes(_restoreFile.Size))? It replaces the settings,
						printer profiles and API key. Files in the backup overwrite files with the same name; other files stay.
					</p>
					<div class="system-actions">
						<button type="button" class="btn btn-ghost" disabled="@_restoring" @onclick="() => _restoreFile = null">Cancel</button>
						<button type="button" class="btn btn-danger" disabled="@(_restoring || _busy)" @onclick="RestoreAsync">
							<Icon Name="refresh" Size="16" /> @(_restoring ? "Restoring…" : "Restore")
						</button>
					</div>
				</div>
			}
		</section>

		<section class="card" aria-labelledby="system-title">
			<header class="card-head"><h2 id="system-title">System</h2></header>
			@if (_health is { } health)
			{
				<ul class="health-list">
					<li>
						<span>Disk</span>
						@if (health.Disk is { } disk)
						{
							<span>@Format.Bytes(disk.FreeBytes) free of @Format.Bytes(disk.TotalBytes)</span>
						}
						else
						{
							<span class="muted">Can't be read</span>
						}
					</li>
					<li>
						<span>Raspberry Pi power</span>
						<span>@(health.Pi switch
						{
							null => "Not a Raspberry Pi",
							{ UnderVoltageNow: true } => "Under-voltage now",
							{ LimitedNow: true } => "Throttled now",
							{ UnderVoltageSinceBoot: true } => "Under-voltage since boot",
							{ LimitedSinceBoot: true } => "Throttled since boot",
							_ => "OK"
						})</span>
					</li>
					<li>
						<span>Firmware</span>
						<span>@(health.Firmware ?? "Not connected")</span>
					</li>
				</ul>
				@if (health.Warnings.Count == 0)
				{
					<p class="muted small"><Icon Name="check" Size="14" /> No problems found.</p>
				}
				@foreach (HealthWarning w in health.Warnings)
				{
					<p class="banner @(w.Severity == HealthSeverity.Error ? "banner-bad" : "banner-warn")"><strong>@w.Title.</strong> @w.Detail</p>
				}
			}
			@if (_hostActions.Count == 0)
			{
				<p class="muted small">
					No commands configured. Set <code>System:RestartCommand</code>, <code>System:RebootCommand</code> and
					<code>System:ShutdownCommand</code> in <code>appsettings.json</code> on the host, for example
					<code>sudo systemctl restart printdeck</code>. They can't be set here, on purpose.
				</p>
			}
			else
			{
				<p class="muted small">Disconnects the printer first. Not available while printing.</p>
				<div class="system-actions">
					@foreach (HostAction action in _hostActions)
					{
						bool armed = _confirmAction == action;
						<button type="button" class="btn @(action == HostAction.RestartPrintDeck ? "" : "btn-danger") @(armed ? "is-armed" : "")"
								disabled="@(_busy || _runningAction)" title="@(_busy ? "Finish the print first" : armed ? "Click again to confirm" : null)"
								@onclick="() => RunHostActionAsync(action)">
							<Icon Name="@(action == HostAction.RestartPrintDeck ? "refresh" : "power")" Size="16" />
							@(armed ? $"Confirm: {HostActionLabel(action)}" : HostActionLabel(action))
						</button>
					}
				</div>
			}
		</section>
	</div>
}

@code {
	private sealed class PresetRow { public string Name { get; set; } = ""; public int Hotend { get; set; } = 200; public int Bed { get; set; } = 60; }

	private sealed class ProfileForm
	{
		public string Id { get; set; } = "";
		public string Name { get; set; } = "";
		public double BedWidth { get; set; }
		public double BedDepth { get; set; }
		public double MaxHeight { get; set; }
		public int ExtruderCount { get; set; }
		public bool HasHeatedBed { get; set; }
		public int JogFeedrateXY { get; set; }
		public int JogFeedrateZ { get; set; }
		public int ExtrudeFeedrate { get; set; }

		public static ProfileForm From(PrinterProfile p) => new()
		{
			Id = p.Id, Name = p.Name, BedWidth = p.BedWidth, BedDepth = p.BedDepth, MaxHeight = p.MaxHeight,
			ExtruderCount = p.ExtruderCount, HasHeatedBed = p.HasHeatedBed,
			JogFeedrateXY = p.JogFeedrateXY, JogFeedrateZ = p.JogFeedrateZ, ExtrudeFeedrate = p.ExtrudeFeedrate
		};

		public PrinterProfile ToProfile() => new()
		{
			Id = Id, Name = Name.Trim(), BedWidth = BedWidth, BedDepth = BedDepth, MaxHeight = MaxHeight,
			ExtruderCount = ExtruderCount, HasHeatedBed = HasHeatedBed,
			JogFeedrateXY = JogFeedrateXY, JogFeedrateZ = JogFeedrateZ, ExtrudeFeedrate = ExtrudeFeedrate
		};
	}

	private sealed class HostForm
	{
		public string? WebcamStreamUrl { get; set; }
		public bool ShowProgressOnPrinter { get; set; } = true;
		public bool AutoConnect { get; set; }
		public string? WebcamSnapshotUrl { get; set; }
		public CameraRotation WebcamRotation { get; set; }
		public bool WebcamFlipHorizontal { get; set; }
		public bool WebcamFlipVertical { get; set; }
		public List<PresetRow> Presets { get; set; } = [];

		public static HostForm From(HostSettings s) => new()
		{
			WebcamStreamUrl = s.WebcamStreamUrl, ShowProgressOnPrinter = s.ShowProgressOnPrinter,
			AutoConnect = s.AutoConnect,
			WebcamSnapshotUrl = s.WebcamSnapshotUrl, WebcamRotation = s.WebcamRotation,
			WebcamFlipHorizontal = s.WebcamFlipHorizontal, WebcamFlipVertical = s.WebcamFlipVertical,
			Presets = s.Presets.Select(x => new PresetRow { Name = x.Name, Hotend = x.Hotend, Bed = x.Bed }).ToList()
		};
	}

	private sealed class SnippetRow { public string Name { get; set; } = ""; public string Gcode { get; set; } = ""; }

	/// <summary>The five scripts in <see cref="ScriptSlots"/> order, and the snippets.</summary>
	private sealed class ScriptsForm
	{
		public string[] Texts { get; private init; } = [];
		public List<SnippetRow> Snippets { get; private init; } = [];

		public static ScriptsForm From(HostSettings s) => new()
		{
			Texts = [s.BeforePrintGcode, s.AfterPrintGcode, s.CancelGcode, s.PauseGcode, s.ResumeGcode],
			Snippets = s.Snippets.Select(x => new SnippetRow { Name = x.Name, Gcode = x.Gcode }).ToList()
		};

		public UpdateGcodeScriptsCommand ToCommand() =>
			new(Texts[0], Texts[1], Texts[2], Texts[3], Texts[4], Snippets.Select(x => new GcodeSnippet(x.Name, x.Gcode)).ToList());
	}

	private static readonly (string Label, string Hint)[] ScriptSlots =
	[
		("Before print", "Sent before the print starts."),
		("After print", "Sent after the print finished."),
		("After cancel", "Sent after a print is cancelled, from PrintDeck or from the printer."),
		("On pause", "Sent after PrintDeck pauses the print, or the printer asks it to (//action:pause). Not when the printer pauses on its own, e.g. M600."),
		("On resume", "Sent before a paused print continues.")
	];

	private ScriptsForm? _scripts;
	private int _scriptSlot;
	private HostSettings? _settings;
	private ProfileForm? _profile;
	private string _profileName = "";
	private HostForm? _host;
	private bool _busy;
	private string? _confirmDelete;
	private IReadOnlyList<HostAction> _hostActions = [];
	private HostAction? _confirmAction;
	private bool _runningAction;
	private IReadOnlyList<ApiKeyInfo> _keys = [];
	private string _keyName = "";
	private bool _creatingKey;
	private string? _newKey;
	private string? _newKeyName;
	private string? _confirmRevoke;
	private bool _confirmSharedOff;
	private IBrowserFile? _restoreFile;
	private bool _restoring;
	private bool _testingSnapshot;
	private CameraControlsDto? _controls;
	private HealthReport? _health;
	private readonly Dictionary<string, long> _sliding = [];
	private CameraSnapshot? _testSnapshot;

	// A backup holds every upload, so it may be far larger than a single G-code file.
	private const long _maxBackup = 64L << 30;

	// Other tabs and the connection panel can switch or edit profiles; the list follows, the open forms stay as typed.
	protected override PrinterChange Interests => PrinterChange.Settings | PrinterChange.State;

	protected override async Task RefreshAsync()
	{
		_settings = await Mediator.Send(new GetSettingsQuery());
		_busy = (await Mediator.Send(new GetPrinterStatusQuery())).State.IsBusy();
		_hostActions = await Mediator.Send(new GetHostActionsQuery());
		_health = await Mediator.Send(new GetHealthQuery());
		_keys = await Mediator.Send(new ListApiKeysQuery());
		if (_profile is null) Edit(_settings.ActiveProfile);
		_host ??= HostForm.From(_settings);
		_scripts ??= ScriptsForm.From(_settings);
		_controls = await Mediator.Send(new GetCameraControlsQuery());
		_sliding.Clear();
	}

	private static string HostActionLabel(HostAction action) => action switch
	{
		HostAction.RestartPrintDeck => "Restart PrintDeck",
		HostAction.RebootHost => "Reboot host",
		_ => "Shut down host"
	};

	private async Task RunHostActionAsync(HostAction action)
	{
		if (_confirmAction != action)
		{
			_confirmAction = action;
			_ = Task.Delay(4000).ContinueWith(_ => InvokeAsync(() => { if (_confirmAction == action) _confirmAction = null; StateHasChanged(); }));
			return;
		}
		_confirmAction = null;
		_runningAction = true;
		try
		{
			string done = action switch
			{
				HostAction.RestartPrintDeck => "Restarting PrintDeck; this page reconnects when it is back.",
				HostAction.RebootHost => "Rebooting the host.",
				_ => "Shutting down the host."
			};
			await Run(new RunHostActionCommand(action), done);
		}
		finally
		{
			_runningAction = false;
		}
	}

	private void PickBackup(InputFileChangeEventArgs e) => _restoreFile = e.File;

	private async Task RestoreAsync()
	{
		if (_restoreFile is null) return;
		_restoring = true;
		try
		{
			await using Stream stream = _restoreFile.OpenReadStream(_maxBackup);
			Result<BackupRestore> result = await Mediator.Send(new RestoreBackupCommand(stream));
			if (!result.IsSuccess)
			{
				Toasts.Error(result.Error ?? "Something went wrong.");
				return;
			}
			int count = result.Value!.Files.Count;
			Toasts.Success($"Restored the settings and {count} file{(count == 1 ? "" : "s")} (backup made {Format.Ago(result.Value.CreatedAt, Time.GetUtcNow())})");
			_restoreFile = null;
			_settings = await Mediator.Send(new GetSettingsQuery());
			_host = HostForm.From(_settings);
			_scripts = ScriptsForm.From(_settings);
			Edit(_settings.ActiveProfile);
		}
		catch (IOException ex)
		{
			Toasts.Error($"Restore failed: {ex.Message}");
		}
		finally
		{
			_restoring = false;
		}
	}

	private static string Summary(PrinterProfile p) =>
		$"{p.BedWidth:0.#} × {p.BedDepth:0.#} × {p.MaxHeight:0.#} mm · {p.ExtruderCount} extruder{(p.ExtruderCount == 1 ? "" : "s")}" +
		(p.HasHeatedBed ? " · heated bed" : "");

	private void Edit(PrinterProfile p)
	{
		_profile = ProfileForm.From(p);
		_profileName = p.Name;
		_confirmDelete = null;
	}

	private void NewProfile()
	{
		Edit(new PrinterProfile { Id = "", Name = "" });
		_profileName = "";
	}

	private void Duplicate(PrinterProfile p)
	{
		Edit(p with { Id = "", Name = $"{p.Name} copy" });
	}

	private async Task SaveProfileAsync()
	{
		bool adding = _profile!.Id.Length == 0;
		Result<string> result = await Mediator.Send(new SavePrinterProfileCommand(_profile.ToProfile()));
		if (!result.IsSuccess)
		{
			Toasts.Error(result.Error ?? "Something went wrong.");
			return;
		}
		_settings = await Mediator.Send(new GetSettingsQuery());
		if (_settings.FindProfile(result.Value!) is { } saved) Edit(saved);
		Toasts.Success(adding ? $"Added {_profileName}" : $"Saved {_profileName}");
	}

	private async Task SelectAsync(PrinterProfile p)
	{
		if (await Run(new SelectPrinterProfileCommand(p.Id), $"Now using {p.Name}"))
			_settings = await Mediator.Send(new GetSettingsQuery());
	}

	private async Task DeleteAsync(PrinterProfile p)
	{
		if (_confirmDelete != p.Id)
		{
			_confirmDelete = p.Id;
			return;
		}
		_confirmDelete = null;
		if (!await Run(new DeletePrinterProfileCommand(p.Id), $"Deleted {p.Name}")) return;
		_settings = await Mediator.Send(new GetSettingsQuery());
		if (_profile?.Id == p.Id) Edit(_settings.ActiveProfile);
	}

	private async Task SaveScriptsAsync()
	{
		if (await Run(_scripts!.ToCommand(), "Scripts saved"))
		{
			_settings = await Mediator.Send(new GetSettingsQuery());
			_scripts = ScriptsForm.From(_settings);
		}
	}

	private async Task SaveHostAsync()
	{
		HostForm f = _host!;
		UpdateSettingsCommand command = new(
			f.Presets.Select(x => new TemperaturePreset(x.Name, x.Hotend, x.Bed)).ToList(), f.WebcamStreamUrl, f.ShowProgressOnPrinter, f.AutoConnect,
			f.WebcamSnapshotUrl, f.WebcamRotation, f.WebcamFlipHorizontal, f.WebcamFlipVertical);
		if (await Run(command, "Settings saved"))
		{
			_settings = await Mediator.Send(new GetSettingsQuery());
			_host = HostForm.From(_settings);
		}
	}

	private async Task SelectCameraAsync(ChangeEventArgs e)
	{
		string? device = e.Value as string;
		if (await Run(new SelectCameraDeviceCommand(device), string.IsNullOrEmpty(device) ? "No camera chosen" : $"Using {device}")) return;
		await ReloadAsync();
	}

	private void Slide(CameraControl c, ChangeEventArgs e)
	{
		if (long.TryParse(e.Value as string, System.Globalization.CultureInfo.InvariantCulture, out long value)) _sliding[c.Name] = value;
	}

	private async Task SetControlAsync(CameraControl c, object? raw)
	{
		long? value = raw switch
		{
			long l => l,
			int i => i,
			string text when long.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, out long parsed) => parsed,
			_ => null
		};
		// On success the Settings change re-reads the controls (another may have turned (in)active); on failure, show the camera's value again.
		if (value is null || !await Run(new SetCameraControlCommand(c.Name, value.Value))) await ReloadAsync();
	}

	private async Task ResetControlsAsync()
	{
		if (!await Run(new ResetCameraControlsCommand(), "Camera controls back to their defaults")) await ReloadAsync();
	}

	private async Task TestSnapshotAsync()
	{
		_testingSnapshot = true;
		_testSnapshot = null;
		try
		{
			Result<CameraSnapshot> result = await Mediator.Send(new TestCameraSnapshotCommand(_host?.WebcamSnapshotUrl ?? ""));
			if (result.IsSuccess) _testSnapshot = result.Value;
			else Toasts.Error(result.Error ?? "Something went wrong.");
		}
		finally
		{
			_testingSnapshot = false;
		}
	}

	private async Task RegenerateAsync()
	{
		bool wasOn = _settings!.SharedApiKeyEnabled;
		Result<string> result = await Mediator.Send(new RegenerateApiKeyCommand());
		if (!result.IsSuccess)
		{
			Toasts.Error(result.Error ?? "Something went wrong.");
			return;
		}
		_settings = await Mediator.Send(new GetSettingsQuery());
		Toasts.Success(wasOn ? "New shared key — update it in your slicer." : "The shared key is on again, with a new key.");
	}

	private async Task CreateKeyAsync()
	{
		_creatingKey = true;
		try
		{
			string name = _keyName.Trim();
			Result<string> result = await Mediator.Send(new CreateApiKeyCommand(name));
			if (!result.IsSuccess)
			{
				Toasts.Error(result.Error ?? "Something went wrong.");
				return;
			}
			_newKey = result.Value;
			_newKeyName = name;
			_keyName = "";
			_keys = await Mediator.Send(new ListApiKeysQuery());
		}
		finally
		{
			_creatingKey = false;
		}
	}

	private async Task RevokeKeyAsync(ApiKeyInfo key)
	{
		if (_confirmRevoke != key.Id)
		{
			_confirmRevoke = key.Id;
			return;
		}
		_confirmRevoke = null;
		if (await Run(new RevokeApiKeyCommand(key.Id), $"Revoked {key.Name}"))
			_keys = await Mediator.Send(new ListApiKeysQuery());
	}

	private async Task DisableSharedKeyAsync()
	{
		if (!_confirmSharedOff)
		{
			_confirmSharedOff = true;
			_ = Task.Delay(4000).ContinueWith(_ => InvokeAsync(() => { _confirmSharedOff = false; StateHasChanged(); }));
			return;
		}
		_confirmSharedOff = false;
		if (await Run(new DisableSharedApiKeyCommand(), "Shared key turned off; only app keys sign in now."))
			_settings = await Mediator.Send(new GetSettingsQuery());
	}
}
