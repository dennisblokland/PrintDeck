@page "/settings"
@inherits PrinterComponent
@inject NavigationManager Nav

<PageTitle>Settings · PrintDeck</PageTitle>

<header class="page-head"><h1>Settings</h1></header>

@if (_form is not null)
{
	<form class="settings" @onsubmit="SaveAsync" @onsubmit:preventDefault>
		<section class="card">
			<header class="card-head"><h2>Printer</h2></header>
			<div class="form-grid">
				<label class="field span-2"><span>Name</span><input class="input" @bind="_form.Name" /></label>
				<label class="field"><span>Bed width (mm)</span><input class="input" type="number" @bind="_form.BedWidth" /></label>
				<label class="field"><span>Bed depth (mm)</span><input class="input" type="number" @bind="_form.BedDepth" /></label>
				<label class="field"><span>Max height (mm)</span><input class="input" type="number" @bind="_form.MaxHeight" /></label>
				<label class="field"><span>Extruders</span><input class="input" type="number" min="1" max="8" @bind="_form.ExtruderCount" /></label>
				<label class="toggle span-2"><input type="checkbox" @bind="_form.HasHeatedBed" /><span>Heated bed</span></label>
			</div>
		</section>

		<section class="card">
			<header class="card-head"><h2>Motion</h2></header>
			<div class="form-grid">
				<label class="field"><span>Jog XY (mm/min)</span><input class="input" type="number" @bind="_form.JogFeedrateXY" /></label>
				<label class="field"><span>Jog Z (mm/min)</span><input class="input" type="number" @bind="_form.JogFeedrateZ" /></label>
				<label class="field"><span>Extrude (mm/min)</span><input class="input" type="number" @bind="_form.ExtrudeFeedrate" /></label>
			</div>
		</section>

		<section class="card">
			<header class="card-head">
				<h2>Temperature presets</h2>
				<button type="button" class="btn btn-sm btn-ghost" @onclick="() => _form.Presets.Add(new PresetRow())">Add preset</button>
			</header>
			<div class="preset-rows">
				@foreach (PresetRow p in _form.Presets)
				{
					<div class="preset-row">
						<input class="input" placeholder="Name" aria-label="Preset name" @bind="p.Name" />
						<label class="field-inline"><Icon Name="flame" Size="14" /><input class="input input-num" type="number" aria-label="Hotend" @bind="p.Hotend" />°</label>
						<label class="field-inline"><Icon Name="bed" Size="14" /><input class="input input-num" type="number" aria-label="Bed" @bind="p.Bed" />°</label>
						<button type="button" class="icon-btn icon-btn-danger" title="Remove" @onclick="() => _form.Presets.Remove(p)"><Icon Name="x" Size="16" /></button>
					</div>
				}
			</div>
		</section>

		<section class="card">
			<header class="card-head"><h2>Cancel script</h2></header>
			<p class="muted small">Sent after a print is cancelled</p>
			<textarea class="input mono" rows="6" spellcheck="false" @bind="_form.CancelGcode"></textarea>
		</section>

		<section class="card">
			<header class="card-head"><h2>Camera</h2></header>
			<label class="field"><span>MJPEG stream URL</span>
				<input class="input" placeholder="http://printer.local:8080/?action=stream" @bind="_form.WebcamStreamUrl" />
			</label>
		</section>

		<section class="card">
			<header class="card-head"><h2>Slicer upload</h2></header>
			<p class="muted small">
				In OrcaSlicer, PrusaSlicer or Cura add a physical printer with host type <strong>OctoPrint</strong>,
				host <code>@Nav.BaseUri.TrimEnd('/')</code> and this API key.
			</p>
			<div class="field-row">
				<input class="input mono" readonly value="@_apiKey" aria-label="API key" />
				<button type="button" class="btn btn-ghost" @onclick="RegenerateAsync"><Icon Name="refresh" Size="16" /> New key</button>
			</div>
		</section>

		<div class="save-bar">
			<button class="btn btn-primary" type="submit"><Icon Name="check" Size="16" /> Save settings</button>
		</div>
	</form>
}

@code {
	private sealed class PresetRow { public string Name { get; set; } = ""; public int Hotend { get; set; } = 200; public int Bed { get; set; } = 60; }

	private sealed class Form
	{
		public string Name { get; set; } = "";
		public double BedWidth { get; set; }
		public double BedDepth { get; set; }
		public double MaxHeight { get; set; }
		public int ExtruderCount { get; set; }
		public bool HasHeatedBed { get; set; }
		public int JogFeedrateXY { get; set; }
		public int JogFeedrateZ { get; set; }
		public int ExtrudeFeedrate { get; set; }
		public string? WebcamStreamUrl { get; set; }
		public string CancelGcode { get; set; } = "";
		public List<PresetRow> Presets { get; set; } = [];
	}

	private Form? _form;
	private PrinterProfile? _loaded;
	private string _apiKey = "";

	protected override PrinterChange Interests => PrinterChange.None;

	protected override async Task RefreshAsync()
	{
		PrinterProfile p = _loaded = await Mediator.Send(new GetPrinterProfileQuery());
		_apiKey = p.ApiKey;
		_form = new Form
		{
			Name = p.Name, BedWidth = p.BedWidth, BedDepth = p.BedDepth, MaxHeight = p.MaxHeight,
			ExtruderCount = p.ExtruderCount, HasHeatedBed = p.HasHeatedBed,
			JogFeedrateXY = p.JogFeedrateXY, JogFeedrateZ = p.JogFeedrateZ, ExtrudeFeedrate = p.ExtrudeFeedrate,
			WebcamStreamUrl = p.WebcamStreamUrl, CancelGcode = p.CancelGcode,
			Presets = p.Presets.Select(x => new PresetRow { Name = x.Name, Hotend = x.Hotend, Bed = x.Bed }).ToList()
		};
	}

	private async Task SaveAsync()
	{
		Form f = _form!;
		PrinterProfile profile = _loaded! with
		{
			Name = f.Name.Trim(), BedWidth = f.BedWidth, BedDepth = f.BedDepth, MaxHeight = f.MaxHeight,
			ExtruderCount = f.ExtruderCount, HasHeatedBed = f.HasHeatedBed,
			JogFeedrateXY = f.JogFeedrateXY, JogFeedrateZ = f.JogFeedrateZ, ExtrudeFeedrate = f.ExtrudeFeedrate,
			WebcamStreamUrl = string.IsNullOrWhiteSpace(f.WebcamStreamUrl) ? null : f.WebcamStreamUrl.Trim(),
			CancelGcode = f.CancelGcode.Replace("\r", ""),
			Presets = f.Presets.Select(x => new TemperaturePreset(x.Name.Trim(), x.Hotend, x.Bed)).ToList()
		};
		if (await Run(new UpdatePrinterProfileCommand(profile), "Settings saved")) _loaded = profile;
	}

	private async Task RegenerateAsync()
	{
		Result<string> result = await Mediator.Send(new RegenerateApiKeyCommand());
		if (result.IsSuccess) { _apiKey = result.Value!; Toasts.Success("New API key — update it in your slicer."); }
	}
}
