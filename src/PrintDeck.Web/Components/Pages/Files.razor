@page "/files"
@inherits PrinterComponent
@inject NavigationManager Nav
@inject IStringLocalizer<Files> L

<PageTitle>@Shared["PageTitle", L["Title"]]</PageTitle>

<header class="page-head">
	<h1>@L["Title"]</h1>
	<nav class="breadcrumbs" aria-label="@L["Breadcrumb"]">
		<button class="crumb @(_folder.Length == 0 ? "is-current" : "")" @onclick='() => OpenFolderAsync("")'><Icon Name="folder" Size="14" /> @L["AllFiles"]</button>
		@foreach (string crumb in Crumbs(_folder))
		{
			<span class="crumb-sep">/</span>
			<button class="crumb @(crumb == _folder ? "is-current" : "")" @onclick="() => OpenFolderAsync(crumb)">@FilePath.Name(crumb)</button>
		}
	</nav>
	<p class="muted">
		@if (Filtered)
		{
			<text>@L["CountOfTotal", _files.Count, FileCount(_total)]</text>
		}
		else
		{
			<text>@FileCount(_files.Count) · @Format.Bytes(_files.Sum(f => f.SizeBytes))</text>
		}
	</p>
</header>

@if (CanControl)
{
	<label class="dropzone @(_uploading ? "is-busy" : "")">
		<InputFile OnChange="UploadAsync" multiple accept=".gcode,.gco,.g" disabled="@_uploading" />
		<Icon Name="upload" Size="26" />
		@if (_uploading)
		{
			<strong>@L["Uploading", _uploadName ?? ""]</strong>
			<span class="muted">@L["Analysing"]</span>
		}
		else
		{
			<strong>@L["Drop"]</strong>
			<span class="muted">
				@(_folder.Length == 0 ? "" : L["IntoFolder", _folder] + " ")@L["SlicerHint"]
			</span>
		}
	</label>
}

@if (_review is { } review)
{
	bool errors = review.Problems.Any(p => p.Severity == GcodeProblemSeverity.Error);
	<section class="card check-dialog @(errors ? "has-errors" : "")" role="alertdialog" aria-labelledby="check-title">
		<header class="card-head">
			<h2 id="check-title">@(review.Problems.Count == 1 ? L.Html("OneProblemInHtml", review.FileName) : L.Html("ProblemsInHtml", review.Problems.Count, review.FileName))</h2>
		</header>
		<ul class="check-list">
			@foreach (GcodeProblem p in review.Problems)
			{
				<li>
					<span class="chip @(p.Severity == GcodeProblemSeverity.Error ? "chip-failed" : "chip-paused")">@(p.Severity == GcodeProblemSeverity.Error ? L["Error"] : L["Warning"])</span>
					<span class="check-message">@p.Message</span>
					<span class="muted small mono">@Where(p)</span>
				</li>
			}
		</ul>
		<div class="actions">
			<button class="btn" @onclick="() => _review = null">@Shared["Cancel"]</button>
			<button class="btn @(errors ? "btn-danger" : "btn-primary")" disabled="@(_state != PrinterState.Operational)"
					@onclick="() => StartAsync(review.FileName)">
				<Icon Name="play" Size="14" /> @L["PrintAnyway"]
			</button>
		</div>
	</section>
}

@if (_total > 0 || _subfolders.Count > 0 || CanControl)
{
	<div class="file-toolbar">
		<input class="input file-search" type="search" placeholder="@L["Search"]" aria-label="@L["Search"]"
			   value="@_search" @oninput="OnSearch" />
		<select class="input" aria-label="@L["SortBy"]" value="@_sort" @onchange="OnSort">
			<option value="@FileSort.Uploaded">@L["SortUploaded"]</option>
			<option value="@FileSort.Name">@L["SortName"]</option>
			<option value="@FileSort.LastPrinted">@L["SortLastPrinted"]</option>
			<option value="@FileSort.Size">@L["SortSize"]</option>
		</select>
		<label class="toggle">
			<input type="checkbox" checked="@_hidePrinted" @onchange="OnHidePrinted" />
			<span>@L["HidePrinted"]</span>
		</label>
		@if (CanControl)
		{
			<button class="btn btn-sm btn-ghost" @onclick="ToggleNewFolder"><Icon Name="folder" Size="14" /> @L["NewFolder"]</button>
		}
	</div>
}

@if (_newFolder is not null)
{
	<form class="card folder-form" @onsubmit="CreateFolderAsync" @onsubmit:preventDefault>
		<input class="input" placeholder="@L["FolderName"]" aria-label="@L["NewFolderName"]" maxlength="@FilePath.MaxSegmentLength" @bind="_newFolder" autofocus />
		<span class="muted small">@L["InFolder", _folder.Length == 0 ? L["AllFiles"] : _folder]</span>
		<button type="button" class="btn btn-ghost" @onclick="() => _newFolder = null">@Shared["Cancel"]</button>
		<button class="btn btn-primary" type="submit"><Icon Name="check" Size="14" /> @L["Create"]</button>
	</form>
}

@if (!Searching && _subfolders.Count > 0)
{
	<ul class="file-list folder-list">
		@foreach (string folder in _subfolders)
		{
			<li class="file folder-row" @key="folder">
				@if (_renaming == folder)
				{
					<form class="folder-form" @onsubmit="() => RenameFolderAsync(folder)" @onsubmit:preventDefault>
						<Icon Name="folder" Size="18" />
						<input class="input" aria-label="@L["FolderName"]" maxlength="@FilePath.MaxSegmentLength" @bind="_renameTo" autofocus />
						<button type="button" class="btn btn-sm btn-ghost" @onclick="() => _renaming = null">@Shared["Cancel"]</button>
						<button class="btn btn-sm btn-primary" type="submit">@L["Rename"]</button>
					</form>
				}
				else
				{
					<button class="folder-open" @onclick="() => OpenFolderAsync(folder)">
						<Icon Name="folder" Size="18" />
						<span class="file-name">@FilePath.Name(folder)</span>
						<span class="muted small">@FolderSummary(folder)</span>
					</button>
					@if (CanControl)
					{
						<div class="file-actions">
							<button class="btn btn-sm btn-ghost" @onclick="() => StartRename(folder)">@L["Rename"]</button>
							<button class="icon-btn icon-btn-danger @(_confirmDelete == FolderKey(folder) ? "is-armed" : "")"
									title="@(_confirmDelete == FolderKey(folder) ? Shared["ClickAgainToDelete"] : L["DeleteEmptyFolder"])" @onclick="() => DeleteFolderAsync(folder)">
								<Icon Name="@(_confirmDelete == FolderKey(folder) ? "check" : "trash")" Size="16" />
							</button>
						</div>
					}
				}
			</li>
		}
	</ul>
}

@if (_files.Count == 0 && (Filtered || _subfolders.Count == 0))
{
	@if (Filtered)
	{
		<div class="card empty"><Icon Name="folder" Size="28" /><p>@L["NoMatch"]</p>
			<button class="btn btn-ghost" @onclick="ShowAllAsync">@L["ShowAll"]</button></div>
	}
	else
	{
		<div class="card empty"><Icon Name="folder" Size="28" /><p>@(_folder.Length == 0 ? L["NoFiles"] : L["FolderEmpty"])</p></div>
	}
}
else if (_files.Count > 0)
{
	<ul class="file-list local-files">
		@foreach (GcodeFile f in _files)
		{
			bool printing = _activeFile == f.Name;
			bool copying = _copyingFile == f.Name;
			<li class="file has-thumb @(printing ? "is-printing" : "")" @key="f.Name">
				<div class="file-thumb" aria-hidden="true">
					@if (f.HasThumbnail)
					{
						<img src="@ThumbnailUrl(f)" alt="" loading="lazy" />
					}
					else
					{
						<Icon Name="file" Size="18" />
					}
				</div>
				<div class="file-main">
					<span class="file-name" title="@f.Name">@(Searching ? f.Name : FilePath.Name(f.Name))</span>
					<span class="file-sub">
						@Format.Bytes(f.SizeBytes) · @Format.Ago(f.UploadedAt, Time.GetUtcNow())
						@if (f.Analysis?.Slicer is { } slicer) { <text> · @slicer</text> }
						@if (f.Prints?.Last is { } last)
						{
							<text> · </text><span class="file-printed @(last.Succeeded ? "is-ok" : "is-bad")"
												   title="@PrintSummary(f.Prints)">@(last.Succeeded ? L["PrintedAgo", Format.Ago(last.EndedAt, Time.GetUtcNow())] : last.Status == JobStatus.Cancelled ? L["CancelledAgo", Format.Ago(last.EndedAt, Time.GetUtcNow())] : L["FailedAgo", Format.Ago(last.EndedAt, Time.GetUtcNow())])</span>
						}
					</span>
				</div>
				<div class="file-stats">
					<span title="@L["EstimatedTime"]"><Icon Name="clock" Size="14" /> @Format.Duration(f.Analysis?.EstimatedPrintTime)</span>
					<span title="@L["Filament"]"><Icon Name="spool" Size="14" /> @Format.Filament(f.Analysis?.FilamentMillimeters)</span>
					<span title="@L["Layers"]"><Icon Name="layers" Size="14" /> @(f.Analysis?.LayerCount?.ToString() ?? "—")</span>
				</div>
				<div class="file-actions">
					<a class="icon-btn" href="viewer/@FileUrl.Path(f.Name)" title="@L["ViewToolpath"]"><Icon Name="eye" Size="16" /></a>
					@if (printing)
					{
						<span class="chip chip-printing">@L["Printing"]</span>
					}
					else if (copying)
					{
						<span class="chip chip-printing">@L["CopyingToSd"]</span>
					}
					else if (CanControl)
					{
						@if (_sd.State == SdCardState.Ready)
						{
							<button class="icon-btn" disabled="@(_state != PrinterState.Operational)"
									title="@(_state != PrinterState.Operational ? L["MustBeIdle"] : L["CopyToSd"])"
									@onclick='() => CopyToSdAsync(f.Name)'>
								<Icon Name="sdcard" Size="16" />
							</button>
						}
						<button class="btn btn-sm btn-primary" disabled="@(_state != PrinterState.Operational || _checking is not null)"
								title="@(_state != PrinterState.Operational ? L["MustBeIdle"] : L["CheckThenPrint"])"
								@onclick="() => PrintAsync(f.Name)">
							<Icon Name="play" Size="14" /> @(_checking == f.Name ? L["Checking"] : L["Print"])
						</button>
						<button class="icon-btn" title="@L["MoveOrRename"]" @onclick="() => StartMove(f.Name)"><Icon Name="folder" Size="16" /></button>
						<button class="icon-btn icon-btn-danger @(_confirmDelete == f.Name ? "is-armed" : "")"
								title="@(_confirmDelete == f.Name ? Shared["ClickAgainToDelete"] : Shared["Delete"])" @onclick="() => DeleteAsync(f.Name)">
							<Icon Name="@(_confirmDelete == f.Name ? "check" : "trash")" Size="16" />
						</button>
					}
				</div>
				@if (_moving == f.Name)
				{
					<form class="folder-form move-form" @onsubmit="() => MoveAsync(f.Name)" @onsubmit:preventDefault>
						<select class="input" aria-label="@L["MoveToFolder"]" @bind="_moveFolder">
							<option value="">@L["TopLevel"]</option>
							@foreach (string folder in _allFolders)
							{
								<option value="@folder">@folder</option>
							}
						</select>
						<input class="input" aria-label="@L["FileName"]" @bind="_moveName" />
						<button type="button" class="btn btn-sm btn-ghost" @onclick="() => _moving = null">@Shared["Cancel"]</button>
						<button class="btn btn-sm btn-primary" type="submit">@L["Move"]</button>
					</form>
				}
			</li>
		}
	</ul>
}

@if (_state.IsConnected())
{
	<section class="sd-section" aria-labelledby="sd-title">
		<div class="sd-head">
			<h2 id="sd-title"><Icon Name="sdcard" Size="16" /> @L["SdCard"]
				<span class="muted">· @SdSummary</span>
			</h2>
			@if (CanControl)
			{
				<div class="sd-head-actions">
					@if (_sd.State == SdCardState.Ready)
					{
						<button class="icon-btn" title="@L["RefreshList"]" @onclick="() => Run(new RefreshSdCardCommand())"><Icon Name="refresh" Size="16" /></button>
						<button class="btn btn-sm btn-ghost" disabled="@_sdBusy" title="@(_sdBusy ? L["SdInUse"] : L["ReleaseTitle"])"
								@onclick='() => Run(new ReleaseSdCardCommand(), L["Released"])'>@L["Release"]</button>
					}
					else
					{
						<button class="btn btn-sm" disabled="@_sdBusy" @onclick="() => Run(new InitSdCardCommand())">@L["Initialise"]</button>
					}
				</div>
			}
		</div>

		@if (_sd.State != SdCardState.Ready)
		{
			<div class="card empty"><Icon Name="sdcard" Size="28" /><p>@(_sd.State == SdCardState.Unknown ? L["CheckingSd"] : L["NoSd"])</p></div>
		}
		else if (_sd.Files.Count == 0)
		{
			<div class="card empty"><Icon Name="sdcard" Size="28" /><p>@L["SdEmpty"]</p></div>
		}
		else
		{
			<ul class="file-list">
				@foreach (SdFile f in _sd.Files)
				{
					bool printing = _sdActive == f.DisplayName;
					<li class="file @(printing ? "is-printing" : "")" @key="f.Path">
						<div class="file-main">
							<span class="file-name" title="@f.DisplayName">@f.DisplayName</span>
							<span class="file-sub"><span class="sd-path">@f.Path</span> · @(f.SizeBytes > 0 ? Format.Bytes(f.SizeBytes) : L["SizeUnknown"])</span>
						</div>
						<div class="file-stats"></div>
						<div class="file-actions">
							@if (printing)
							{
								<span class="chip chip-printing">@L["Printing"]</span>
							}
							else if (CanControl)
							{
								<button class="btn btn-sm btn-primary" disabled="@(_state != PrinterState.Operational)"
										title="@(_state != PrinterState.Operational ? L["MustBeIdle"] : L["PrintFromSd"])"
										@onclick='() => Run(new StartSdPrintCommand(f.Path), L["PrintingFromSd", f.DisplayName])'>
									<Icon Name="play" Size="14" /> @L["Print"]
								</button>
								<button class="icon-btn icon-btn-danger @(_confirmDelete == SdKey(f) ? "is-armed" : "")" disabled="@_sdBusy"
										title="@(_confirmDelete == SdKey(f) ? L["ConfirmDeleteFromSd"] : L["DeleteFromSd"])"
										@onclick="() => DeleteSdAsync(f)">
									<Icon Name="@(_confirmDelete == SdKey(f) ? "check" : "trash")" Size="16" />
								</button>
							}
						</div>
					</li>
				}
			</ul>
		}
	</section>
}

@code {
	private const long _maxUpload = 1L << 30;
	private IReadOnlyList<GcodeFile> _files = [];
	private PrinterState _state;
	private string? _activeFile;
	private string? _copyingFile;
	private string? _sdActive;
	private bool _sdBusy;
	private SdCardDto _sd = new(SdCardState.Unknown, []);
	private bool _uploading;
	private string? _uploadName;
	private string? _confirmDelete;
	private string? _checking;
	private int _total;

	// The view lives in these fields and is mirrored in the address (?q=…&sort=…&hide=true),
	// so a reload or a bookmark keeps it. Handlers change the fields first: quick successive
	// changes never build on an address that hasn't caught up yet.
	[SupplyParameterFromQuery(Name = "q")] private string? QueryText { get; set; }
	[SupplyParameterFromQuery(Name = "sort")] private string? QuerySort { get; set; }
	[SupplyParameterFromQuery(Name = "hide")] private bool QueryHide { get; set; }
	[SupplyParameterFromQuery(Name = "folder")] private string? QueryFolder { get; set; }

	private string _folder = "";
	private IReadOnlyList<string> _allFolders = [];
	private IReadOnlyList<string> _subfolders = [];
	private IReadOnlyList<GcodeFile> _everything = [];
	private string? _newFolder;
	private string? _renaming;
	private string _renameTo = "";
	private string? _moving;
	private string _moveFolder = "";
	private string _moveName = "";

	private bool Searching => !string.IsNullOrWhiteSpace(_search);

	private string? _search;
	private FileSort _sort;
	private bool _hidePrinted;
	private bool _initialized;

	private bool Filtered => !string.IsNullOrWhiteSpace(_search) || _hidePrinted;

	private (string? Search, FileSort Sort, bool Hide, string Folder) FromQuery =>
		(string.IsNullOrWhiteSpace(QueryText) ? null : QueryText,
		 Enum.TryParse(QuerySort, ignoreCase: true, out FileSort s) ? s : FileSort.Uploaded,
		 QueryHide,
		 FilePath.Normalize(QueryFolder) ?? "");

	protected override async Task OnInitializedAsync()
	{
		// Before the first listing, so a reload or bookmark opens on the saved view.
		(_search, _sort, _hidePrinted, _folder) = FromQuery;
		_initialized = true;
		await base.OnInitializedAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		// Back/forward or an edited address: follow it.
		if (!_initialized || FromQuery == (_search, _sort, _hidePrinted, _folder)) return;
		(_search, _sort, _hidePrinted, _folder) = FromQuery;
		await RefreshAsync();
	}

	private Task OpenFolderAsync(string folder)
	{
		_folder = folder;
		_newFolder = null;
		_renaming = null;
		_moving = null;
		return ApplyAsync(null, _sort, _hidePrinted);
	}

	private static IEnumerable<string> Crumbs(string folder)
	{
		if (folder.Length == 0) yield break;
		string[] parts = folder.Split('/');
		for (int i = 1; i <= parts.Length; i++) yield return string.Join('/', parts[..i]);
	}

	private string FolderSummary(string folder) => FileCount(_everything.Count(f => FilePath.IsWithin(f.Name, folder)));

	private string FileCount(int n) => n == 1 ? L["OneFile"] : L["FileCount", n];

	private static string FolderKey(string folder) => "folder:" + folder;

	private void ToggleNewFolder() => _newFolder = _newFolder is null ? "" : null;

	private async Task CreateFolderAsync()
	{
		string name = (_newFolder ?? "").Trim();
		if (await Run(new CreateFolderCommand(FilePath.Combine(_folder, name)), L["FolderCreated", name])) _newFolder = null;
	}

	private void StartRename(string folder)
	{
		_renaming = folder;
		_renameTo = FilePath.Name(folder);
	}

	private async Task RenameFolderAsync(string folder)
	{
		string target = FilePath.Combine(FilePath.Folder(folder), _renameTo.Trim());
		if (await Run(new MoveFolderCommand(folder, target), L["RenamedTo", _renameTo.Trim()])) _renaming = null;
	}

	private async Task DeleteFolderAsync(string folder)
	{
		string key = FolderKey(folder);
		if (_confirmDelete != key)
		{
			_confirmDelete = key;
			_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { if (_confirmDelete == key) _confirmDelete = null; StateHasChanged(); }));
			return;
		}
		_confirmDelete = null;
		await Run(new DeleteFolderCommand(folder), L["FolderDeleted", FilePath.Name(folder)]);
	}

	private void StartMove(string name)
	{
		_moving = name;
		_moveFolder = FilePath.Folder(name);
		_moveName = FilePath.Name(name);
	}

	private async Task MoveAsync(string name)
	{
		string target = FilePath.Combine(_moveFolder, _moveName.Trim());
		if (await Run(new MoveGcodeCommand(name, target), L["MovedTo", target])) _moving = null;
	}

	private Task OnSearch(ChangeEventArgs e) => ApplyAsync(e.Value as string, _sort, _hidePrinted);
	private Task OnSort(ChangeEventArgs e) => ApplyAsync(_search, Enum.TryParse(e.Value as string, out FileSort s) ? s : FileSort.Uploaded, _hidePrinted);
	private Task OnHidePrinted(ChangeEventArgs e) => ApplyAsync(_search, _sort, e.Value is true);
	private Task ShowAllAsync() => ApplyAsync(null, _sort, false);

	private async Task ApplyAsync(string? search, FileSort sort, bool hidePrinted)
	{
		(_search, _sort, _hidePrinted) = (string.IsNullOrWhiteSpace(search) ? null : search, sort, hidePrinted);
		Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
		{
			["q"] = _search,
			["sort"] = _sort == FileSort.Uploaded ? null : _sort.ToString().ToLowerInvariant(),
			["hide"] = _hidePrinted ? true : null,
			["folder"] = _folder.Length == 0 ? null : _folder
		}), replace: true);
		await RefreshAsync();
	}

	private string PrintSummary(PrintStats p) =>
		(p.Completed == 1 ? L["OneSuccessfulPrint"] : L["SuccessfulPrints", p.Completed])
		+ (p.Unsuccessful > 0 ? L["Unsuccessful", p.Unsuccessful] : "")
		+ (p.TotalPrintTime > TimeSpan.Zero ? L["PrintingTime", Format.Duration(p.TotalPrintTime)] : "")
		+ (p.TotalFilamentMm > 0 ? L["FilamentUsed", Format.Filament(p.TotalFilamentMm)] : "");
	private (string FileName, IReadOnlyList<GcodeProblem> Problems)? _review;

	protected override PrinterChange Interests => PrinterChange.Files | PrinterChange.State | PrinterChange.Job;
	protected override TimeSpan Throttle => TimeSpan.FromMilliseconds(500);

	protected override async Task RefreshAsync()
	{
		_allFolders = await Mediator.Send(new ListFoldersQuery());
		if (_folder.Length > 0 && !_allFolders.Contains(_folder)) _folder = ""; // renamed or deleted meanwhile
		_subfolders = _allFolders.Where(f => FilePath.Folder(f) == _folder).ToList();
		_everything = await Mediator.Send(new ListGcodeFilesQuery());
		_files = await Mediator.Send(new ListGcodeFilesQuery(_search, _sort, _hidePrinted, _folder));
		_total = Filtered ? _everything.Count(f => FilePath.IsWithin(f.Name, _folder)) : _files.Count;
		PrinterStatusDto status = await Mediator.Send(new GetPrinterStatusQuery());
		_state = status.State;
		JobDto? active = status.Job is { Status: JobStatus.Printing or JobStatus.Paused } j ? j : null;
		_activeFile = active is { Kind: JobKind.Print } ? active.FileName : null;
		_copyingFile = active is { Kind: JobKind.SdUpload } ? active.FileName : null;
		_sdActive = active is { Kind: JobKind.SdPrint } ? active.FileName : null;
		_sdBusy = active is { Kind: JobKind.SdPrint or JobKind.SdUpload };
		_sd = await Mediator.Send(new GetSdCardQuery());
	}

	private async Task UploadAsync(InputFileChangeEventArgs e)
	{
		IReadOnlyList<IBrowserFile> files = e.GetMultipleFiles(20);
		_uploading = true;
		_uploadName = files.Count == 1 ? files[0].Name : L["FileCount", files.Count];
		try
		{
			foreach (IBrowserFile file in files)
			{
				await using Stream stream = file.OpenReadStream(_maxUpload);
				Result<GcodeFile> result = await Mediator.Send(new UploadGcodeCommand(file.Name, stream, _folder));
				if (result.IsSuccess) Toasts.Success(L["Uploaded", result.Value!.Name]);
				else Toasts.Error(result.Error!);
			}
		}
		catch (IOException ex)
		{
			Toasts.Error(L["UploadFailed", ex.Message]);
		}
		finally
		{
			_uploading = false;
			await RefreshAsync();
		}
	}

	private string SdSummary => _sd.State switch
	{
		SdCardState.Ready => FileCount(_sd.Files.Count),
		SdCardState.Unavailable => L["SdNotAvailable"],
		_ => L["SdUnknown"]
	};

	private static string SdKey(SdFile f) => "sd:" + f.Path;

	private async Task CopyToSdAsync(string name)
	{
		Result<string> result = await Mediator.Send(new CopyToSdCardCommand(name));
		if (result.IsSuccess) Toasts.Success(L["CopyingTo", name, result.Value!]);
		else Toasts.Error(result.Error!);
	}

	private async Task DeleteSdAsync(SdFile f)
	{
		string key = SdKey(f);
		if (_confirmDelete != key)
		{
			_confirmDelete = key;
			_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { if (_confirmDelete == key) _confirmDelete = null; StateHasChanged(); }));
			return;
		}
		_confirmDelete = null;
		await Run(new DeleteSdFileCommand(f.Path), L["DeletedFromSd", f.DisplayName]);
	}

	/// <summary>Checks the file first; a clean file starts at once, otherwise the problems are shown.</summary>
	private async Task PrintAsync(string name)
	{
		_review = null;
		_checking = name;
		try
		{
			IReadOnlyList<GcodeProblem>? problems = await Mediator.Send(new CheckGcodeFileQuery(name));
			if (problems is null) Toasts.Error(L["NotFound", name]);
			else if (problems.Count == 0) await StartAsync(name);
			else _review = (name, problems);
		}
		finally
		{
			_checking = null;
		}
	}

	private async Task StartAsync(string name)
	{
		_review = null;
		await Run(new StartPrintCommand(name, IgnoreProblems: true), L["PrintingFile", name]);
	}

	private string Where(GcodeProblem p) =>
		(p.FirstLine, p.Count) switch
		{
			(null, _) => "",
			({ } line, 1) => L["Line", line],
			({ } line, int n) => L["LineAndMore", line, n - 1]
		};

	private async Task DeleteAsync(string name)
	{
		if (_confirmDelete != name)
		{
			_confirmDelete = name;
			_ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => { if (_confirmDelete == name) _confirmDelete = null; StateHasChanged(); }));
			return;
		}
		_confirmDelete = null;
		await Run(new DeleteGcodeCommand(name), L["Deleted", name]);
	}

	private static string ThumbnailUrl(GcodeFile f) => $"thumbnail/{FileUrl.Path(f.Name)}?v={f.UploadedAt.UtcTicks:x}";
}
