@page "/timelapse"
@inherits PrinterComponent
@inject IStringLocalizer<Timelapse> L

<PageTitle>@Shared["PageTitle", L["Title"]]</PageTitle>

<header class="page-head">
	<h1>@L["Title"]</h1>
	<p class="muted">@L["Intro"]</p>
</header>

@if (_data is { } d)
{
	TimelapseStatus s = d.Status;
	@if (s.Recording is { } recording)
	{
		<div class="banner timelapse-status" role="status">
			<span class="rec-dot" aria-hidden="true"></span>
			<span>@L.Html("RecordingHtml", recording, Frames(s.Frames))</span>
		</div>
	}
	@if (s.Rendering is { } rendering)
	{
		<div class="banner timelapse-status" role="status">
			<span class="spinner" aria-hidden="true"></span>
			<span>@L.Html("RenderingHtml", rendering, Frames(s.Frames))</span>
		</div>
	}
	@if (s.LastError is { } error)
	{
		<div class="banner banner-warn timelapse-status" role="alert"><Icon Name="alert" Size="16" /> <span>@error</span></div>
	}
	@if (_mode == TimelapseMode.Off && s.Recording is null)
	{
		<p class="muted small timelapse-hint">
			@L["Off"]
			@if (CanControl)
			{
				@L.Html("SwitchOnHtml")
			}
		</p>
	}

	@if (d.Videos.Count == 0)
	{
		<div class="card empty"><Icon Name="camera" Size="28" /><p>@L["Empty"]</p></div>
	}
	else
	{
		<div class="timelapse-grid">
			@foreach (TimelapseVideo v in d.Videos)
			{
				string url = $"timelapse/{Uri.EscapeDataString(v.Name)}";
				<section class="card timelapse-card" @key="v.Name">
					<video class="timelapse-video" src="@url" controls preload="metadata" playsinline></video>
					<div class="timelapse-meta">
						<div class="timelapse-name" title="@v.Name">@v.Name</div>
						<div class="muted small">
							<span title="@v.CreatedAt.ToLocalTime().ToString("f")">@Format.Ago(v.CreatedAt, Time.GetUtcNow())</span>
							· @Format.Bytes(v.SizeBytes)
						</div>
					</div>
					<div class="timelapse-actions">
						<a class="btn btn-sm btn-ghost" href="@($"{url}?download=true")" download title="@L["SaveVideo"]"><Icon Name="down" Size="14" /> @Shared["Download"]</a>
						@if (CanControl)
						{
							<button class="icon-btn icon-btn-danger @(_confirmDelete == v.Name ? "is-armed" : "")"
									title="@(_confirmDelete == v.Name ? Shared["ClickAgainToDelete"] : Shared["Delete"])" @onclick="() => DeleteAsync(v.Name)">
								<Icon Name="@(_confirmDelete == v.Name ? "check" : "trash")" Size="16" />
							</button>
						}
					</div>
				</section>
			}
		</div>
	}
}

@code {
	private TimelapsesDto? _data;
	private TimelapseMode _mode;
	private string? _confirmDelete;

	protected override PrinterChange Interests => PrinterChange.Timelapse | PrinterChange.Settings;
	protected override TimeSpan Throttle => TimeSpan.FromMilliseconds(500);

	protected override async Task RefreshAsync()
	{
		_data = await Mediator.Send(new GetTimelapsesQuery());
		_mode = (await Mediator.Send(new GetSettingsQuery())).Timelapse.Mode;
	}

	private string Frames(int n) => n == 1 ? L["OneFrame"] : L["Frames", n];

	private async Task DeleteAsync(string name)
	{
		if (_confirmDelete != name)
		{
			_confirmDelete = name;
			return;
		}
		_confirmDelete = null;
		if (await Run(new DeleteTimelapseCommand(name), L["Deleted"])) await RefreshAsync();
	}
}
