@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics
@inject IStringLocalizer<Error> L

<PageTitle>@L["Title"]</PageTitle>

<h1 class="text-danger">@L["Heading"]</h1>
<h2 class="text-danger">@L["Text"]</h2>

@if (ShowRequestId)
{
	<p>
		<strong>@L["RequestId"]</strong> <code>@RequestId</code>
	</p>
}

<h3>@L["DevelopmentMode"]</h3>
<p>@L.Html("DevelopmentDetailsHtml")</p>
<p>@L.Html("DevelopmentWarningHtml")</p>

@code{
	[CascadingParameter]
	private HttpContext? HttpContext { get; set; }

	[PersistentState]
	public string? RequestId { get; set; }

	private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

	protected override void OnInitialized()
	{
		RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
	}
}
