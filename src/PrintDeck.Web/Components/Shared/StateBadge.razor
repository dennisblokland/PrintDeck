<span class="state state-@State.ToString().ToLowerInvariant()">
	<span class="state-dot"></span>@Label
</span>

@code {
	[Parameter] public PrinterState State { get; set; }

	private string Label => State switch
	{
		PrinterState.Offline => "Offline",
		PrinterState.Connecting => "Connecting…",
		PrinterState.Operational => "Ready",
		PrinterState.Printing => "Printing",
		PrinterState.Paused => "Paused",
		PrinterState.Cancelling => "Cancelling",
		PrinterState.Transferring => "Copying to SD",
		_ => "Error"
	};
}
