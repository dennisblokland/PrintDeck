<span class="state state-@State.ToString().ToLowerInvariant()">
	<span class="state-dot"></span>@Label
</span>

@inject IStringLocalizer<StateBadge> L

@code {
	[Parameter] public PrinterState State { get; set; }

	private string Label => State switch
	{
		PrinterState.Offline => L["Offline"],
		PrinterState.Connecting => L["Connecting"],
		PrinterState.Operational => L["Ready"],
		PrinterState.Printing => L["Printing"],
		PrinterState.Paused => L["Paused"],
		PrinterState.Cancelling => L["Cancelling"],
		PrinterState.Transferring => L["Transferring"],
		_ => L["Error"]
	};
}
