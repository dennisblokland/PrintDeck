@page "/setup"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout Layout.AuthLayout
@inject SignInManager<PrintDeckUser> SignInManager
@inject IMediator Mediator
@inject NavigationManager Nav
@inject IStringLocalizer<Setup> L
@inject IStringLocalizer<SharedText> Shared

<PageTitle>@Shared["PageTitle", L["Title"]]</PageTitle>

<h1 class="auth-title">@L["Heading"]</h1>
<p class="muted small">@L["Intro"]</p>

@if (_error is not null)
{
	<p class="auth-error" role="alert">@_error</p>
}

<EditForm Model="Input" method="post" OnValidSubmit="CreateAsync" FormName="setup" class="auth-form">
	<DataAnnotationsValidator />
	<label class="field">
		<span>@Shared["Username"]</span>
		<InputText class="input" @bind-Value="Input!.UserName" autocomplete="username" autofocus />
		<ValidationMessage For="() => Input!.UserName" />
	</label>
	<label class="field">
		<span>@Shared["Password"]</span>
		<InputText class="input" type="password" @bind-Value="Input!.Password" autocomplete="new-password" />
		<ValidationMessage For="() => Input!.Password" />
	</label>
	<label class="field">
		<span>@L["RepeatPassword"]</span>
		<InputText class="input" type="password" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
		<ValidationMessage For="() => Input!.ConfirmPassword" />
	</label>
	<button class="btn btn-primary btn-block" type="submit">@L["Create"]</button>
</EditForm>

@code {
	[SupplyParameterFromForm] private NewAccountInput? Input { get; set; }
	private string? _error;

	protected override async Task OnInitializedAsync()
	{
		Input ??= new();
		if (!await Mediator.Send(new IsSetupRequiredQuery())) Nav.NavigateTo("login");
	}

	private async Task CreateAsync()
	{
		Result created = await Mediator.Send(new CreateFirstAdminCommand(Input!.UserName, Input!.Password));
		if (!created.IsSuccess)
		{
			_error = created.Error;
			return;
		}
		await SignInManager.PasswordSignInAsync(Input!.UserName.Trim(), Input!.Password, isPersistent: true, lockoutOnFailure: false);
		Nav.NavigateTo("");
	}
}
