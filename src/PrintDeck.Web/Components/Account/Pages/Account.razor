@page "/account"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@inject SignInManager<PrintDeckUser> SignInManager
@inject UserManager<PrintDeckUser> UserManager
@inject IMediator Mediator

<PageTitle>Account · PrintDeck</PageTitle>

<h1 class="auth-title">Your account</h1>
<p class="muted small">Signed in as <strong>@HttpContext.User.Identity?.Name</strong> · @(HttpContext.User.IsInRole(nameof(UserRole.Admin)) ? "Admin" : "Viewer")</p>

@if (_error is not null)
{
	<p class="auth-error" role="alert">@_error</p>
}
@if (_done)
{
	<p class="auth-ok" role="status">Password changed. Your other devices are signed out.</p>
}

<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password" class="auth-form">
	<DataAnnotationsValidator />
	<label class="field">
		<span>Current password</span>
		<InputText class="input" type="password" @bind-Value="Input!.CurrentPassword" autocomplete="current-password" />
		<ValidationMessage For="() => Input!.CurrentPassword" />
	</label>
	<label class="field">
		<span>New password</span>
		<InputText class="input" type="password" @bind-Value="Input!.NewPassword" autocomplete="new-password" />
		<ValidationMessage For="() => Input!.NewPassword" />
	</label>
	<label class="field">
		<span>Repeat new password</span>
		<InputText class="input" type="password" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
		<ValidationMessage For="() => Input!.ConfirmPassword" />
	</label>
	<button class="btn btn-primary btn-block" type="submit">Change password</button>
</EditForm>

<form class="auth-signout" method="post" action="account/logout">
	<AntiforgeryToken />
	<button class="btn btn-ghost btn-block" type="submit"><Icon Name="logout" Size="16" /> Sign out</button>
</form>

<a class="auth-back" href="">← Back to PrintDeck</a>

@code {
	[CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
	[SupplyParameterFromForm] private ChangePasswordInput? Input { get; set; }
	private string? _error;
	private bool _done;

	protected override void OnInitialized() => Input ??= new();

	private async Task ChangeAsync()
	{
		Result changed = await Mediator.Send(new ChangeOwnPasswordCommand(Input!.CurrentPassword, Input!.NewPassword));
		if (!changed.IsSuccess)
		{
			_error = changed.Error;
			return;
		}
		// The new security stamp would sign this browser out too; re-issue its cookie so only other devices are.
		if (await UserManager.GetUserAsync(HttpContext.User) is { } user) await SignInManager.RefreshSignInAsync(user);
		_done = true;
		Input = new();
	}

	private sealed class ChangePasswordInput
	{
		[Required(ErrorMessage = "Enter your current password.")] public string CurrentPassword { get; set; } = "";

		[Required(ErrorMessage = "Choose a new password.")]
		[StringLength(128, MinimumLength = 8, ErrorMessage = "Use at least 8 characters.")]
		public string NewPassword { get; set; } = "";

		[Compare(nameof(NewPassword), ErrorMessage = "The passwords don't match.")] public string ConfirmPassword { get; set; } = "";
	}
}
