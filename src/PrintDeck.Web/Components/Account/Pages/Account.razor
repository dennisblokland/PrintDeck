@page "/account"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@inject SignInManager<PrintDeckUser> SignInManager
@inject UserManager<PrintDeckUser> UserManager
@inject IMediator Mediator
@inject IStringLocalizer<Account> L
@inject IStringLocalizer<SharedText> Shared

<PageTitle>@Shared["PageTitle", L["Title"]]</PageTitle>

<h1 class="auth-title">@L["Heading"]</h1>
<p class="muted small">@L.Html("SignedInAsHtml", HttpContext.User.Identity?.Name) · @(HttpContext.User.IsInRole(nameof(UserRole.Admin)) ? Shared["RoleAdmin"] : Shared["RoleViewer"])</p>

@if (_error is not null)
{
	<p class="auth-error" role="alert">@_error</p>
}
@if (_done)
{
	<p class="auth-ok" role="status">@L["Changed"]</p>
}

<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password" class="auth-form">
	<DataAnnotationsValidator />
	<label class="field">
		<span>@L["CurrentPassword"]</span>
		<InputText class="input" type="password" @bind-Value="Input!.CurrentPassword" autocomplete="current-password" />
		<ValidationMessage For="() => Input!.CurrentPassword" />
	</label>
	<label class="field">
		<span>@L["NewPassword"]</span>
		<InputText class="input" type="password" @bind-Value="Input!.NewPassword" autocomplete="new-password" />
		<ValidationMessage For="() => Input!.NewPassword" />
	</label>
	<label class="field">
		<span>@L["RepeatNewPassword"]</span>
		<InputText class="input" type="password" @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
		<ValidationMessage For="() => Input!.ConfirmPassword" />
	</label>
	<button class="btn btn-primary btn-block" type="submit">@L["ChangePassword"]</button>
</EditForm>

<form class="auth-signout" method="post" action="account/logout">
	<AntiforgeryToken />
	<button class="btn btn-ghost btn-block" type="submit"><Icon Name="logout" Size="16" /> @L["SignOut"]</button>
</form>

<a class="auth-back" href="">@L["Back"]</a>

@code {
	[CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
	[SupplyParameterFromForm] private ChangePasswordInput? Input { get; set; }
	private string? _error;
	private bool _done;

	protected override void OnInitialized() => Input ??= new();

	private async Task ChangeAsync()
	{
		Result changed = await Mediator.Send(new ChangeOwnPasswordCommand(Input!.CurrentPassword, Input!.NewPassword));
		if (!changed.IsSuccess)
		{
			_error = changed.Error;
			return;
		}
		// The new security stamp would sign this browser out too; re-issue its cookie so only other devices are.
		if (await UserManager.GetUserAsync(HttpContext.User) is { } user) await SignInManager.RefreshSignInAsync(user);
		_done = true;
		Input = new();
	}

	private sealed class ChangePasswordInput
	{
		[Required(ErrorMessageResourceType = typeof(AccountText), ErrorMessageResourceName = nameof(AccountText.EnterCurrentPassword))] public string CurrentPassword { get; set; } = "";

		[Required(ErrorMessageResourceType = typeof(AccountText), ErrorMessageResourceName = nameof(AccountText.ChooseNewPassword))]
		[StringLength(128, MinimumLength = 8, ErrorMessageResourceType = typeof(AccountText), ErrorMessageResourceName = nameof(AccountText.PasswordTooShort))]
		public string NewPassword { get; set; } = "";

		[Compare(nameof(NewPassword), ErrorMessageResourceType = typeof(AccountText), ErrorMessageResourceName = nameof(AccountText.PasswordsDiffer))] public string ConfirmPassword { get; set; } = "";
	}
}
