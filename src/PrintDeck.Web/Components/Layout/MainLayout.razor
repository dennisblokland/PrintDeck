@inherits LayoutComponentBase
@inject IStringLocalizer<MainLayout> L
@inject IStringLocalizer<SharedText> Shared

<div class="shell">
	<aside class="sidebar">
		<a class="brand" href="">
			<span class="brand-mark"><Icon Name="logo" Size="22" /></span>
			<span class="brand-name">PrintDeck</span>
		</a>

		<nav class="nav" aria-label="@L["MainNavigation"]">
			<NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="gauge" /> <span>@L["Dashboard"]</span></NavLink>
			<AuthorizeView Roles="@nameof(UserRole.Admin)">
				<NavLink class="nav-link" href="control"><Icon Name="move" /> <span>@L["Control"]</span></NavLink>
			</AuthorizeView>
			<NavLink class="nav-link" href="files"><Icon Name="folder" /> <span>@L["Files"]</span></NavLink>
			<NavLink class="nav-link" href="history"><Icon Name="clock" /> <span>@L["History"]</span></NavLink>
			<NavLink class="nav-link" href="timelapse"><Icon Name="camera" /> <span>@L["Timelapse"]</span></NavLink>
			<NavLink class="nav-link" href="viewer"><Icon Name="cube" /> <span>@L["Viewer"]</span></NavLink>
			<AuthorizeView Roles="@nameof(UserRole.Admin)">
				<NavLink class="nav-link" href="terminal"><Icon Name="terminal" /> <span>@L["Terminal"]</span></NavLink>
				<NavLink class="nav-link" href="settings"><Icon Name="sliders" /> <span>@L["Settings"]</span></NavLink>
				<NavLink class="nav-link" href="users"><Icon Name="users" /> <span>@L["Users"]</span></NavLink>
			</AuthorizeView>
		</nav>

		<ConnectionPanel />

		<AuthorizeView>
			<div class="user-box">
				<a class="user-name" href="account" title="@L["AccountTitle"]">
					<Icon Name="user" Size="16" />
					<span>@context.User.Identity?.Name</span>
				</a>
				<form method="post" action="account/logout">
					<AntiforgeryToken />
					<button class="icon-btn" type="submit" title="@L["SignOut"]" aria-label="@L["SignOut"]"><Icon Name="logout" Size="16" /></button>
				</form>
			</div>
		</AuthorizeView>
	</aside>

	<main class="main">
		<PrinterDialog />
		<HealthBanner />
		<AppKeyRequestBanner />
		@Body
	</main>
</div>

<Toasts />

<div id="blazor-error-ui" data-nosnippet>
	@L["SomethingBroke"] <a href="." class="reload">@L["Reload"]</a>
	<span class="dismiss" title="@Shared["Dismiss"]"><Icon Name="x" Size="16" /></span>
</div>
