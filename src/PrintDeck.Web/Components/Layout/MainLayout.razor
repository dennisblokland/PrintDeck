@inherits LayoutComponentBase

<div class="shell">
	<aside class="sidebar">
		<a class="brand" href="">
			<span class="brand-mark"><Icon Name="logo" Size="22" /></span>
			<span class="brand-name">PrintDeck</span>
		</a>

		<nav class="nav" aria-label="Main">
			<NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="gauge" /> <span>Dashboard</span></NavLink>
			<AuthorizeView Roles="@nameof(UserRole.Admin)">
				<NavLink class="nav-link" href="control"><Icon Name="move" /> <span>Control</span></NavLink>
			</AuthorizeView>
			<NavLink class="nav-link" href="files"><Icon Name="folder" /> <span>Files</span></NavLink>
			<NavLink class="nav-link" href="history"><Icon Name="clock" /> <span>History</span></NavLink>
			<NavLink class="nav-link" href="timelapse"><Icon Name="camera" /> <span>Timelapse</span></NavLink>
			<NavLink class="nav-link" href="viewer"><Icon Name="cube" /> <span>Viewer</span></NavLink>
			<AuthorizeView Roles="@nameof(UserRole.Admin)">
				<NavLink class="nav-link" href="terminal"><Icon Name="terminal" /> <span>Terminal</span></NavLink>
				<NavLink class="nav-link" href="settings"><Icon Name="sliders" /> <span>Settings</span></NavLink>
				<NavLink class="nav-link" href="users"><Icon Name="users" /> <span>Users</span></NavLink>
			</AuthorizeView>
		</nav>

		<ConnectionPanel />

		<AuthorizeView>
			<div class="user-box">
				<a class="user-name" href="account" title="Your account and password">
					<Icon Name="user" Size="16" />
					<span>@context.User.Identity?.Name</span>
				</a>
				<form method="post" action="account/logout">
					<AntiforgeryToken />
					<button class="icon-btn" type="submit" title="Sign out" aria-label="Sign out"><Icon Name="logout" Size="16" /></button>
				</form>
			</div>
		</AuthorizeView>
	</aside>

	<main class="main">
		<PrinterDialog />
		<HealthBanner />
		@Body
	</main>
</div>

<Toasts />

<div id="blazor-error-ui" data-nosnippet>
	Something broke. <a href="." class="reload">Reload</a>
	<span class="dismiss" title="Dismiss"><Icon Name="x" Size="16" /></span>
</div>
