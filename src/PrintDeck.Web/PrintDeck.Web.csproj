<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PrintDeck.Infrastructure\PrintDeck.Infrastructure.csproj" />
    <ProjectReference Include="..\PrintDeck.Application\PrintDeck.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For "dotnet ef migrations add": the migrations live in PrintDeck.Infrastructure (see README). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Mediator.SourceGenerator">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!--
    TypeScript (Scripts/**/*.ts → wwwroot/js) compiled with the tsc from package.json, so the build needs
    Node.js/npm. npm ci runs when package-lock.json changes; tsc runs when a source or config changes.
    The generated .js files are added as Content so static web assets pick them up on the first build.
  -->
  <ItemGroup>
    <TypeScriptSource Include="Scripts/**/*.ts" />
    <Content Remove="package.json;package-lock.json;tsconfig.json" />
    <None Include="package.json;package-lock.json;tsconfig.json" />
  </ItemGroup>

  <Target Name="NpmInstall" Inputs="package-lock.json" Outputs="node_modules/.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" />
  </Target>

  <Target Name="CompileTypeScript" DependsOnTargets="NpmInstall" BeforeTargets="BeforeBuild"
          Inputs="@(TypeScriptSource);tsconfig.json;package-lock.json" Outputs="$(IntermediateOutputPath)tsc.stamp">
    <Exec Command="npx --no-install tsc -p tsconfig.json" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(IntermediateOutputPath)tsc.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeTypeScriptOutput" AfterTargets="CompileTypeScript" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Content Remove="wwwroot/js/**" />
      <Content Include="wwwroot/js/**" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="PrintDeck.Web.Tests" />
  </ItemGroup>

</Project>
