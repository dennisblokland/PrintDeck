<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The contract between PrintDeck and its modules. It references nothing else of PrintDeck, so a module built
    against it can't reach the session, the stores or the Mediator handlers (see ModuleBoundaryTests).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PrintDeck.Plugins</RootNamespace>
  </PropertyGroup>

</Project>
